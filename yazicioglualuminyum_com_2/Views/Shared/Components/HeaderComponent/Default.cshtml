@model GenelViewModel



<header class="main-header-three">
    <div class="main-menu-three__top">
        <div class="container">
            <div class="main-menu-three__top-inner">
                <ul class="list-unstyled main-menu-three__contact-list">
                    <li>
   
                        <div class="text">
                            <p>@Model.SiteAyar.Slogan</p>
                        </div>
                    </li>
   
                </ul>
                <div class="main-menu-three__top-right">
 
                    <div class="main-menu-three__social">
                        @foreach (var item in Model.SosyalMedyaAdresler)
                        {
                            <a href="@item.Url" target="_blank"><i class="@item.Ikon"></i></a>

                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <nav class="main-menu">
        <div class="main-menu-three__wrapper">
            <div class="container">
                <div class="main-menu-three__wrapper-inner">
                    <div class="main-menu-three__left">
                        <div class="main-menu-three__logo">
                            <a href="/anasayfa/anasayfa.html"><img style="max-height:40px;" src="@Model.Ftp.DosyaAdresOnEki@Model.SiteAyar.HeaderLogoKoyuRenk" alt="@Model.SiteAyar.SiteAdi"></a>
                        </div>
                    </div>
                    <div class="main-menu-three__main-menu-box">
                        <a href="#" class="mobile-nav__toggler"><i class="fa fa-bars"></i></a>
                        <ul class="main-menu__list">

                            @foreach (var item in Model.Menuler.Where(x => x.AnaMenuId == 0).ToList())
                            {
                                @if (Model.Menuler.Where(a => a.AnaMenuId == item.Id).Count() == 0)
                                {
                                    <li><a href="@item.BaglantiAdresi">@item.MenuAdi</a></li>
                                }
                                else
                                {
                                    <li class="dropdown">
                                        <a href="#">@item.MenuAdi</a>
                                        <ul class="shadow-box">
                                            @foreach (var altitem in Model.Menuler.Where(c => c.AnaMenuId == item.Id))
                                            {
                                                <li><a href="@item.BaglantiAdresi">@altitem.MenuAdi</a></li>
                                            }
                                        </ul>
                                    </li>
                                }
                            }

                        </ul>
                    </div>
                    <div class="main-menu-three__right">
                        <div class="main-menu-three__right-content">
                            <div class="main-menu-three__btn-box">
                                <a class="thm-btn" href="contact.html">
                                    Teklif Al
                                    <span class="fas fa-arrow-right"></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>

<div class="stricky-header stricked-menu main-menu main-menu-three">
    <div class="sticky-header__content"></div><!-- /.sticky-header__content -->
</div><!-- /.stricky-header -->


