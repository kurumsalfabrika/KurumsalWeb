@model IletisimViewModel
@section Styles {
    <!-- GOOGLE WEB FONT -->
    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700" rel="stylesheet">
    <!-- BASE CSS -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/menu.css" rel="stylesheet">
    <link href="~/css/responsive.css" rel="stylesheet">
    <link href="~/css/elegant_font/elegant_font.min.css" rel="stylesheet">
    <link href="~/css/fontello/css/fontello.min.css" rel="stylesheet">
    <link href="~/css/magnific-popup.min.css" rel="stylesheet">
    <link href="~/css/bs-icon-font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <link href="~/pro/css/all.css" rel="stylesheet" />
    <link href="~/css/skins/square/grey.css" rel="stylesheet">
    <!-- SPECIFIC CSS -->
    <link href="~/css/carousel_home.css" rel="stylesheet">
    <link href="~/css/skins/square/grey.css" rel="stylesheet">
    <!-- YOUR CUSTOM CSS -->
    <link href="~/css/custom.css" rel="stylesheet">
}


<section class="parallax_window_in short" data-parallax="scroll" data-image-src="~/img/subheader_in_3.jpg" data-natural-width="1400" data-natural-height="350">
    <div id="sub_content_in">
        <div class="container">
            <h1>İletişim</h1>
            <p>"Bizimle iletişime geçmek için aşağıdaki seçenekleri kullanabilirsiniz"</p>
        </div>
    </div>
</section><!-- End section -->

<main>
    <div class="container margin_60_35">
        <div class="row">

            <div class="col-lg-9">

                <hr>

                <div id="message-contact"></div>
                Tebrikler Mesajınız alındı. En kısa sürede değerlendirelecektir.
            </div><!-- End col-md-9 -->

            <div class="col-lg-3">
                <div class="box_style_2">
                    <h5 class="mt-2">Adres</h5>
                    <ul>
                        <li>@Model.IletisimAyar.FirmaAdres</li>
                    </ul>

                    <ul>
                        <strong>Telefonlar</strong>
                        <br>
                        <li><a href="tel://@Model.IletisimAyar.Telefon1">@Model.IletisimAyar.Telefon1</a></li>
                        <li><a href="tel://@Model.IletisimAyar.Telefon2">@Model.IletisimAyar.Telefon2</a></li>
                        <li><a href="tel://@Model.IletisimAyar.Telefon3">@Model.IletisimAyar.Telefon3</a></li>
                        <li><a href="tel://@Model.IletisimAyar.Telefon4">@Model.IletisimAyar.Telefon4</a></li>
                        <strong>E-Posta</strong>
                        <br>
                        <li><a href="@Model.IletisimAyar.IletisimEposta">@Model.IletisimAyar.IletisimEposta</a></li>

                    </ul>
                </div>
                <div class="quote_banner"><a href="https://www.youtube.com/watch?v=c-ufJ5r__cM&amp;ab_channel=DUMANSAF%C4%B0RREZ%C4%B0DANS" target="_blank">Neredeyiz?</a></div>

                <div class="icon-location"><a href="https://www.youtube.com/watch?v=c-ufJ5r__cM&amp;ab_channel=DUMANSAF%C4%B0RREZ%C4%B0DANS" target="_blank">Navigasyon</a></div>
            </div><!-- End col-md-3 -->
        </div><!-- End row -->
    </div><!-- End container -->
</main><!-- End main -->
@section Scripts {
    <!-- Common scripts -->
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/common_scripts_min.js"></script>
    <script src="~/js/functions.js"></script>
    <!--Owl carousel/slider -->
    <script src="~/js/slider.js"></script>
    <!-- Specific scripts -->
    <script src="~/js/jquery.validate.js"></script>
    <script src="~/js/jquery.stepy.min.js"></script>
    <script src="~/js/quotation-validate.js"></script>
}