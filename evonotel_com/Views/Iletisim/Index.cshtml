@{
    Layout = "~/Views/Shared/_IceriLayout.cshtml";
}
@using Kurumsal.Core.Functions
@model AnasayfaViewModel
<style>
    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    #map-canvas {
        width: 100%;
        height: 100%;
    }

    .infowindow-content {
        font-family: Arial, sans-serif;
        font-size: 14px;
    }

    .infowindow-button {
        margin-top: 10px;
        padding: 6px 12px;
        background-color: #2e2f81;
        color: #fff;
        text-decoration: none;
        border-radius: 4px;
        display: inline-block;
    }
</style>
<!-- =========== GOOGLE MAP ========== -->
<div id="map">

    <div id="map-canvas"></div>
</div>
<script>
    function initialize() {
      const konum = { lat: 36.269328, lng: 32.312763 }; // Marker konumu (İşkar Cd. Gazipaşa)

      const map = new google.maps.Map(document.getElementById("map-canvas"), {
        zoom: 17,
        center: konum,
      });

      const marker = new google.maps.Marker({
        position: konum,
        map: map,
        title: "Evon Otel Gazipaşa"
      });

      const infoWindow = new google.maps.InfoWindow({
        content: `
          <div class="infowindow-content">
            <strong>Evon Otel Gazipaşa</strong><br>
            İşkar Cd., Gazipaşa/Antalya<br>
            <a href="https://www.google.com/maps/dir/?api=1&destination=36.269328,32.312763" target="_blank" class="infowindow-button">
              Yol Tarifi Al
            </a>
          </div>
        `
      });

      // Açıklama penceresini otomatik olarak aç
      infoWindow.open(map, marker);

      // Tıklanınca da tekrar açılabilsin
      marker.addListener("click", () => {
        infoWindow.open(map, marker);
      });
    }
</script>
<main id="contact_page">
    <div class="container">
        <div class="row">

            <div class="col-md-8">
                <div class="main_title a_left">
                    <h2>BİZE ULAŞIN</h2>
                </div>
                <form method="post" id="contact-form-page" asp-action="Gonder" asp-controller="Iletisim">
                    <div class="row">
                        <div class="form-group col-md-6 col-sm-6">
                            <label class="control-label">Ad Soyad</label>
                            <input type="text" class="form-control" name="AdSoyad" placeholder="Ad Soyad">
                        </div>
                        <div class="form-group col-md-6 col-sm-6">
                            <label class="control-label">Telefon</label>
                            <input type="text" class="form-control" name="Telefon" placeholder="Telefon">
                        </div>
                        <div class="form-group col-md-6 col-sm-6">
                            <label class="control-label">E-Posta</label>
                            <input type="email" class="form-control" name="Eposta" placeholder="E-Posta">
                        </div>
                        <div class="form-group col-md-6 col-sm-6">
                            <label class="control-label">Konu</label>
                            <input type="text" class="form-control" name="Konu" placeholder="Konu">
                        </div>
                        <div class="form-group col-md-12">
                            <label class="control-label">Mesajınız</label>
                            <textarea class="form-control" name="Mesaj" placeholder="Mesajınız..."></textarea>
                        </div>
                        <div class="form-group col-md-12">
                            <button type="submit" class="button  btn_blue mt40 pull-right">
                                <i class="fa fa-paper-plane-o" aria-hidden="true"></i> Mesaj Gönder
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-md-4">
                <div class="main_title a_left">
                    <h2>İLETİŞİME GEÇİN</h2>
                </div>
                <ul class="contact-info ">
                    <li>
                        <span>Adres:</span> @Model.IletisimAyar.FirmaAdres
                    </li>
                    <li>
                        <span>E-Posta:</span>@Model.IletisimAyar.IletisimEposta
                    </li>
   
                    <li>
                        <span>Telefon:</span> <strong>@Model.IletisimAyar.Telefon1</strong>
                    </li>
                    <li>
                        <span>Gsm:</span>
                        <strong>@Model.IletisimAyar.GSM</strong>
                    </li>
                </ul>
                <div class="social_media">
                    <a class="facebook" data-original-title="Facebook" data-toggle="tooltip" href="https://www.facebook.com/evonapartotel"><i class="fa fa-facebook"></i></a>
                    <a class="instagram" data-original-title="Instagram" data-toggle="tooltip" href="https://www.instagram.com/evonotel/"><i class="fa fa-instagram"></i></a>
                </div>
            </div>
        </div>
    </div>
</main>
