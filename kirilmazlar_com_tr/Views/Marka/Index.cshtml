@model MarkaViewModel


@{
    ViewData["Title"] = "Markalar";
}


    <!-- INNER PAGE BANNER -->
    <div class="wt-bnr-inr overlay-wraper" style="background-image:url(~/assets/images/banner/gallery-banner.jpg);">
        <div class="overlay-main bg-black opacity-07"></div>
        <div class="container">
            <div class="wt-bnr-inr-entry">
                <h1 class="text-white">Markalar</h1>
            </div>
        </div>
    </div>
    <!-- INNER PAGE BANNER END -->
    <!-- BREADCRUMB ROW -->
    <div class="bg-gray-light p-tb20">
        <div class="container">
            <ul class="wt-breadcrumb breadcrumb-style-2">
                <li><a href="/anasayfa/kirilmazlar-yapi.html"><i class="fa fa-home"></i> Anasayfa</a></li>
                <li>Markalar</li>
            </ul>
        </div>
    </div>
    <!-- BREADCRUMB  ROW END -->
    <!-- SECTION CONTENT START -->
    <div class="section-full p-t80 p-b50">
        <div class="container">
        <div class="row">
            <!-- Eksik olan bu -->
        @foreach (var marka in Model.Markalar.OrderBy(m => m.MarkaSira))
        {
            <div class="masonry-item cat-1 col-lg-3 col-md-3 col-sm-6 col-xs-6">
                <div class="wt-gallery-bx p-a15">
                    <div class="wt-img-effect blurr">
                  
                      
                            <img src="@Model.Ftp.DosyaAdresOnEki@marka.OneCikanGorsel" alt="@marka.MarkaAdi">
                    
                       
                    </div>
                </div>
            </div>
        }

   </div>
   </div>



        </div>
 
    <!-- SECTION CONTENT END -->


