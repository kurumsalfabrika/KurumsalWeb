@model HeaderViewModel
<!-- FOOTER START -->
<footer class="site-footer footer-light">
    <!-- COLL-TO ACTION START -->
    <!-- FOOTER BLOCKES START -->
    <div class="footer-top overlay-wraper">
        <div class="overlay-main"></div>
        <div class="container">
            <div class="row">
                <!-- Hakkımızda -->
                <div class="col-lg-3 col-md-6">
                    <div class="widget widget_about">
                        <h4 class="widget-title">Hakkımızda</h4>
                        <div class="logo-footer clearfix p-b15">
                            <a href="/anasayfa/kirilmazlar-yapi-malzemeleri.html">
                                <img src="@Model.Ftp.DosyaAdresOnEki@Model.SiteAyar.FooterLogo" width="230" height="67" alt="">
                            </a>
                        </div>
                        <p>@Model.SiteAyar.KisaHakkindaYazisi</p>
                    </div>
                </div>

                <!-- Adres Bilgileri -->
                <div class="col-lg-6 col-md-6">
                    <div class="row">
                        @foreach (var item in Model.IletisimAdresleri)
                        {
                            <div class="col-md-6 mb-4">
                                <div class="address-box p-3 border rounded h-100 bg-light">
                                    <h5 class="mb-2">
                                        @item.FirmaUnvani
                                    </h5>

                                    @if (!string.IsNullOrWhiteSpace(item.FirmaAdres))
                                    {
                                        <p><i class="fa fa-map-marker me-2 text-secondary"></i> @item.FirmaAdres</p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.Telefon1) && item.Telefon1 != "0")
                                    {
                                        <p><i class="fa fa-phone me-2 text-secondary"></i> @item.Telefon1</p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.Faks))
                                    {
                                        <p><i class="fa fa-fax me-2 text-secondary"></i> @item.Faks</p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.IletisimEposta))
                                    {
                                        <p>
                                            <i class="fa fa-envelope me-2 text-secondary"></i>
                                            <a href="mailto:@item.IletisimEposta">@item.IletisimEposta</a>
                                        </p>
                                    }

                                   @if (!string.IsNullOrWhiteSpace(item.XKoordinat) && !string.IsNullOrWhiteSpace(item.YKoordinat))
                                    {
                                    <p>
                                        <i class="fa fa-map me-2 text-secondary"></i>
                                            <a href="@string.Format("https://www.google.com/maps?q={0},{1}",
                                                   item.XKoordinat.Replace(",", "."), item.YKoordinat.Replace(",", "."))"
                                       target="_blank" rel="noopener noreferrer">
                                        Yol Tarifi Al
                                    </a>

                                    </p>
                                    }

                                </div>
                            </div>
                        }

                    </div>
                </div>

                <!-- Sosyal Medya -->
                <div class="col-lg-3 col-md-6">
                    <div class="widget widget_social_inks">
                        <h4 class="widget-title">Sosyal Medya</h4>
                        <ul class="social-icons social-square social-darkest">
                            @if (Model.SosyalMedyaAdresler != null && Model.SosyalMedyaAdresler.Any())
                            {
                                foreach (var item in Model.SosyalMedyaAdresler)
                                {
                                    <li><a href="@item.Url" target="_blank"><i class="@item.Ikon"></i></a></li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>


        </div>
    </div>
 
    <!-- FOOTER COPYRIGHT -->
    <div class="footer-bottom overlay-wraper">
        <div class="overlay-main"></div>
        <div class="constrot-strip"></div>
        <div class="container p-t30">
            <div class="row">
                <div class="wt-footer-bot-left">
                    <span class="copyrights-text">© 2025 Kırılmazlar. Tüm Hakları Saklıdır. Tasarım: Kurumsal Fabrika.</span>
                </div>
                <div class="wt-footer-bot-right">
                    <ul class="copyrights-nav pull-right">
                        <li><a href="/sayfa/kullanim-sartlari-4.html">Kullanım Şartları</a></li>
                        <li><a href="/sayfa/gizlilik-ilkeleri-5.html">Gizlilik Politikası</a></li>
                        <li><a href="/iletisim/bize-ulasin.html">İletişim</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

</footer>
<!-- FOOTER END -->