@model AnasayfaViewModel
<!-- HEADER START -->
<header class="site-header header-style-1 mobile-sider-drawer-menu">

    <div class="top-bar bg-secondry">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="wt-topbar-left">
                <p class="mb-0 text-white">@Model.SiteAyar.Slogan</p>
            </div>
            <div class="wt-topbar-right d-flex align-items-center">
                <ul class="list-unstyled e-p-bx mb-0 me-3">
                    <li><i class="fa fa-envelope"></i> @Model.IletisimAyar.IletisimEposta</li>
                    <li><i class="fa fa-phone"></i> @Model.IletisimAyar.Telefon1</li>
                </ul>
                <ul class="social-bx list-inline mb-0">

                    @if (Model.SosyalMedyaAdresler != null && Model.SosyalMedyaAdresler.Any())
                    {
                        foreach (var item in Model.SosyalMedyaAdresler)
                        {
                            <li><a href="@item.Url" target="_blank"><i class="@item.Ikon"></i></a></li>
                        }
                    }

                </ul>
            </div>
        </div>
    </div>


    <div class="sticky-header main-bar-wraper">
        <div class="main-bar bg-white">
            <div class="container">
                <div class="logo-header">
                    <a href="/anasayfa/kirilmazlar-yapi-malzemeleri.html">
                        <img src="@Model.Ftp.DosyaAdresOnEki@Model.SiteAyar.HolderLogo" width="171" alt="@Model.SiteAyar.SiteAdi">
                    </a>
                </div>

                <!-- MAIN Vav -->
                <div class="header-nav navbar-collapse collapse ">
                    <ul class=" nav navbar-nav">


                        @foreach (var item in Model.AnaMenuler)
                        {

                            @if (Model.Menuler.Where(x => x.AnaMenuId == item.Id).Count() == 0)
                            {

                                <li>
                                    <a href="@item.BaglantiAdresi">@item.MenuAdi</a>
                                </li>


                            }
                            else
                            {
                                <li class="">
                                    <a href="@item.BaglantiAdresi">@item.MenuAdi<i class="fa fa-chevron-down"></i></a>
                                    <ul class="sub-menu">

                                        @foreach (var itemAlt in Model.Menuler.Where(a => a.AnaMenuId == item.Id))
                                        {
                                            <li class="nav-item">
                                                <a href="@itemAlt.BaglantiAdresi">@itemAlt.MenuAdi</a>
                                            </li>
                                        }

                                    </ul>
                                </li>
                            }
                        }
                        <li class="teklif-btn">
                            <a href="https://tahsilat.kirilmazlar.com.tr/" target="_blank">ONLİNE ÖDEME</a>
                        </li>
                    </ul>
                </div>

                <!-- NAV Toggle Button -->
                <button id="mobile-side-drawer" data-target=".header-nav" data-toggle="collapse" type="button" class="navbar-toggler collapsed">
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar icon-bar-first"></span>
                    <span class="icon-bar icon-bar-two"></span>
                    <span class="icon-bar icon-bar-three"></span>
                </button>

            </div>
        </div>
    </div>

</header>

<div id="cookieConsentBanner" class="cookie-consent-banner" style="display:none;">
    <p>
        <strong>Çerezler ve Kişisel Verilerin Saklanması</strong><br />
        Sitemizin düzgün çalışması, güvenliğinizi sağlamak ve deneyiminizi iyileştirmek amacıyla çerezler kullanıyoruz.
        Detaylı bilgi için <a href="/gizlilik-politikasi/cerez-politikasi" target="_blank">çerez politikamızı</a> inceleyebilirsiniz.
    </p>
    <div class="cookie-buttons">
        <button id="cookieSettingsBtn">Çerezleri Ayarla</button>
        <button id="cookieRejectBtn">Tümünü Reddet</button>
        <button id="cookieAcceptBtn">Tümünü Kabul Et</button>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (!localStorage.getItem("cookieConsent")) {
            document.getElementById("cookieConsentBanner").style.display = "block";
        }

        document.getElementById("cookieAcceptBtn").onclick = function () {
            localStorage.setItem("cookieConsent", "accepted");
            document.getElementById("cookieConsentBanner").style.display = "none";
        };

        document.getElementById("cookieRejectBtn").onclick = function () {
            localStorage.setItem("cookieConsent", "rejected");
            document.getElementById("cookieConsentBanner").style.display = "none";
        };

        document.getElementById("cookieSettingsBtn").onclick = function () {
            alert("Çerez ayarları bölümü henüz aktif değil."); // Geliştirilebilir
        };
    });
</script>


<!-- HEADER END -->