@{
    ViewData["Title"] = "Gökhan Eraslan İnşaat - KAYSERİ";
}
@using Kurumsal.Core.Functions
@model SayfaViewModel

<div class="detaypagetop">

    <div>


        <div class="detaypagetoptitle txtcenter">
                        @if (Model.Sayfa == null)
                    {
                <h1>Sayfa Bulunamadı!</h1>
                    }
                    else
                    {
                        <h1>@Model.Sayfa.Baslik</h1>
                    }

        </div>
    </div>

</div>

<div class="container projelist hakk">
    <section>
        <div class="iccenter">
            <div class="fullcenter">
                <div class="detaypage">



                    @if (Model.Sayfa == null)
                    {
                        <div class="alert alert-warning" role="alert">
                            Sayfa bulunamadı.
                        </div>
                    }
                    else
                    {

                        <h2>@Model.Sayfa.Baslik</h2>
                        <div class="tema1 mtop">
                            <div>
                                <img src="@Model.Ftp.DosyaAdresOnEki@Model.Sayfa.OneCikanGorsel" />
                            </div>
                            <div>
                                <h1>
                                    @Html.Raw(Model.Sayfa.SpotMetin)
                                </h1>

                                <div>
                                    @Html.Raw(Model.Sayfa.Icerik)
                                </div>
                            </div>
                        </div>
                    }

                   



                </div>
            </div>
        </div>
    </section>
</div>

