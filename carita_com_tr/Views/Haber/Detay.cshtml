@{
    ViewData["Title"] = "Gökhan Eraslan İnşaat - KAYSERİ";
}
@using Kurumsal.Core.Functions
@model HaberViewModel

<div class="detaypagetop">

    <div>


        <div class="detaypagetoptitle txtcenter">
            @if (Model.Haber == null)
            {
                <h1>Haber Bulunamadı!</h1>
            }
            else
            {
                <h1>@Model.Haber.Baslik</h1>
            }

        </div>
    </div>

</div>

<div class="container projelist hakk">
    <section>
        <div class="iccenter">
            <div class="fullcenter">
                <div class="detaypage">



                    @if (Model.Haber == null)
                    {
                        <div class="alert alert-warning" role="alert">
                            Haber bulunamadı.
                        </div>
                    }
                    else
                    {

                        <h2>@Model.Haber.Baslik</h2>
                        <div class="tema1 mtop">
                            <div>
                                <img src="@Model.Ftp.DosyaAdresOnEki@Model.Haber.OneCikanGorsel" />
                            </div>
                            <div>
                                <h1>
                                    @Html.Raw(Model.Haber.SpotMetin)
                                </h1>

                                <div>
                                    @Html.Raw(Model.Haber.Icerik)
                                </div>
                            </div>
                        </div>
                    }





                </div>
            </div>
        </div>
    </section>
</div>

