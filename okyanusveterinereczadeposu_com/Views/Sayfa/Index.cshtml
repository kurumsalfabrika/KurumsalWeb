@using Kurumsal.Core.Functions
@using Kurumsal.Entities.Concrete
@model SayfaViewModel

@{
    if (Model.Sayfa != null)
    {
        ViewData["Title"] = Model.Sayfa.Baslik;
    }
    else
    {
        Model.Sayfa = new Sayfa();
        Model.Sayfa.Baslik = "Sayfa Bulunamadı";
    }
}
<!-- Inner Page Main Banner __________________ -->
<div class="inner-page-banner">
	<div class="opacity">
		<div class="container">
			<h2>@Model.Sayfa.Baslik</h2>
		</div> <!-- /.container -->
	</div> <!-- /.opacity -->
</div> <!-- /.inner-page-banner -->
<!-- Page Breadcrum __________________________ -->
<div class="page-breadcrum">
	<div class="container">
		<ul>
			<li><a href="/anasayfa/anasayfa.html">Anasayfa</a></li>
			<li>-</li>
			<li>@Model.Sayfa.Baslik</li>
		</ul>
	</div> <!-- /.container -->
</div> <!-- /.page-breadcrum -->
<!-- Blog Details __________________________ -->
<div class="blog-details-page">
	<div class="container">
		<div class="row">

			<div class="col-lg-8 col-md-8 col-sm-12 col-xs-12 blog-details-page-content">
				<div class="main-wrapper clear-fix">
					@if (!string.IsNullOrEmpty(Model.Sayfa.OneCikanGorsel))
					{
						<div class="img-holder">
							<img src="@($"{Model.Ftp.DosyaAdresOnEki}{Model.Sayfa.OneCikanGorsel}")"
								 alt="@Model.Sayfa.Baslik">
						</div>
					}
	
					<div class="main-post-content">

						<h3 style="padding-top:30px;">@Model.Sayfa.Baslik</h3>

				@Html.Raw(Model.Sayfa.Icerik)
					</div> 
				</div>
			</div> 
			<!-- _______________ SideBar ___________________ -->
			<div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 sidebarOne">
				<div class="wrapper-left">

					<div class="sidebar-box quick-event-list">
						<div class="box-wrapper">
							<h4>Sayfalar</h4>
							<ul>
								@foreach (var item in Model.Sayfalar)
								{
									<li class="@(item.Id == Model.Sayfa.Id ? "active" : "")">
										<a href="@Url.Content("~/sayfa/"
											+ SeoUrlGenerator.GenerateSlug(item.Baslik)
											+ "-" + item.Id + ".html")"
									   class="tran3s">
										<i class="fa fa-angle-double-right" aria-hidden="true"></i>
										@item.Baslik
									</a>
								</li>
																}
							</ul>
						</div> <!-- /.box-wrapper -->
					</div> <!-- /.sidebar-box.quick-event-list -->


				</div> <!-- /.wrapper -->
			</div> <!-- /.sidebarOne -->
		</div>
	</div> <!-- /.container -->
</div> <!-- /.blog-details-page -->
