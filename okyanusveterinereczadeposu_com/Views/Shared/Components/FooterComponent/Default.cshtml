@model GenelViewModel
<footer>
	<div class="top-footer">
		<div class="container">
			<div class="row">
				<div class="col-lg-5 col-md-6 col-sm-6 col-xs-12 footer-about">
					<h4>Hakkımızda</h4>
					<p>Firmamız, veterinerlik ve hayvan sağlığı alanında kaliteli ürün ve güvenilir hizmet anlayışıyla faaliyet göstermektedir. Aşılar, yem katkıları, ilaçlar ve sağlık çözümleri başta olmak üzere geniş ürün yelpazemizle sektördeki ihtiyaçlara profesyonel çözümler sunuyoruz. Müşteri memnuniyetini ve etik değerleri ön planda tutarak, sürdürülebilir ve sağlıklı bir gelecek için çalışıyoruz.</p>
					<a href="about-us.html" class="tran3s"><i class="fa fa-caret-right" aria-hidden="true"></i> Hakkımızda</a>
					<a href="our-teacher.html" class="tran3s"><i class="fa fa-caret-right" aria-hidden="true"></i> İletişim</a>
					<ul>
						<li><a href="#" class="tran3s round-border icon"><i class="fa fa-facebook" aria-hidden="true"></i></a></li>
						<li><a href="#" class="tran3s round-border icon"><i class="fa fa-instagram" aria-hidden="true"></i></a></li>
					</ul>
				</div> <!-- /.footer-about -->

				<div class="col-lg-4 col-md-6 col-sm-6 col-xs-12 footer-contact">
					<h4>İLETİŞİM</h4>
					<ul>
						<li>
							<i class="fa fa-envelope-o" aria-hidden="true"></i>
							<a href="mailto:info@okyanusveterinereczadeposu.com" class="tran3s">info@okyanusveterinereczadeposu.com</a>
						</li>
						<li>
							<i class="fa fa-phone" aria-hidden="true"></i>
							<a href="tel:+903522312898" class="tran3s">+90352 231 28 98 - +90 545 312 31 29 </a>
						</li>
						<li><i class="fa fa-map-marker" aria-hidden="true"></i>Mithatpaşa Mh. Gizem Sk. No:2/A KAYSERİ</li>
					</ul>
				</div> <!-- /.footer-contact -->

				<div class="col-lg-3 col-md-6 col-sm-6 col-xs-12 footer-quick-link">
					<h4>Sayfalar</h4>
					<ul>

						@foreach (var item in Model.Menuler.Where(x => x.AnaMenuId == 0 & x.MenuYeriId == 3).ToList())
						{
							@if (Model.Menuler.Where(a => a.AnaMenuId == item.Id).Count() == 0)
							{


								<li><a href="@item.BaglantiAdresi" class="tran3s"><i class="fa fa-caret-right" aria-hidden="true"></i> @item.MenuAdi</a></li>



							}
							else
							{
								<li class="dropdown-holder">
									<a href="#" class="dropdown-toggle" data-toggle="dropdown">@item.MenuAdi</a>
									<ul class="sub-menu">
										@foreach (var altitem in Model.Menuler.Where(c => c.AnaMenuId == item.Id))
										{
											<li><a href="@item.BaglantiAdresi">@altitem.MenuAdi</a></li>
										}
									</ul>
								</li>
							}
						}

						</ul>
				</div> <!-- /.footer-quick-link -->


			</div> <!-- /.row -->
		</div> <!-- /.container -->
	</div> <!-- /.top-footer -->

	<div class="bottom-footer">
		<p>Copyright 2026 &copy; <a href="http://www.okyanusveterinereczadeposu.com" class="tran3s" target="_blank">Okyanus Veteriner Ecza Deposu</a> </p>
	</div> <!-- /.bottom-footer -->
</footer>
