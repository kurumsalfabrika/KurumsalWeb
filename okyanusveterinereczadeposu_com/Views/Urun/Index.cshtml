@using Kurumsal.Core.Functions

@model UrunViewModel
@{
	ViewData["Title"] = Model.Urun.Baslik;
}



<!-- Inner Page Main Banner __________________ -->
<div class="inner-page-banner">
	<div class="opacity">
		<div class="container">
			<h2>@Model.Urun.Baslik</h2>
		</div> <!-- /.container -->
	</div> <!-- /.opacity -->
</div> <!-- /.inner-page-banner -->
<!-- Page Breadcrum __________________________ -->
<div class="page-breadcrum">
	<div class="container">
		<ul>
			<li><a href="/anasayfa/anasayfa.html">Anasayfa</a></li>
			<li>-</li>
			<li><a href="@Url.Content("~/urun-kategori/" + SeoUrlGenerator.GenerateSlug(Model.UrunKategori.KategoriAdi) + "-" + Model.UrunKategori.Id + ".html")">@Model.UrunKategori.KategoriAdi</a></li>
			<li>-</li>
			<li>@Model.Urun.Baslik</li>
		</ul>
	</div> <!-- /.container -->
</div> <!-- /.page-breadcrum -->
<!-- Blog Details __________________________ -->
<div class="blog-details-page">
	<div class="container">
		<div class="row">

			<div class="col-lg-8 col-md-8 col-sm-12 col-xs-12 blog-details-page-content">
				<div class="main-wrapper clear-fix">
					<div class="img-holder center-item">
						<img src="@Model.Ftp.DosyaAdresOnEki@Model.Urun.OneCikanGorsel" alt="@Model.Urun.Baslik">
					</div>
					<div class="main-post-content">
						@Html.Raw(Model.Urun.Icerik)
					</div> <!-- /.main-post-content -->
				</div>
			</div> <!-- /blog-details-page-content -->
			<!-- _______________ SideBar ___________________ -->
			<div class="col-lg-4 col-md-4 col-sm-12 col-xs-12 sidebarOne">
				<div class="wrapper-left">

					<div class="sidebar-box quick-event-list">
						<div class="box-wrapper">
							<h4>Ürün Kategorileri</h4>
							<ul>
								@foreach (var item in Model.UrunKategoriler)
								{
									<li class="@(item.Id == Model.UrunKategori.Id ? "active" : "")">
										<a href="@Url.Content("~/urun-kategori/"
											+ SeoUrlGenerator.GenerateSlug(item.KategoriAdi)
											+ "-" + item.Id + ".html")"
									   class="tran3s">
										<i class="fa fa-angle-double-right" aria-hidden="true"></i>
										@item.KategoriAdi
									</a>
								</li>
																}
							</ul>
						</div> <!-- /.box-wrapper -->
					</div> <!-- /.sidebar-box.quick-event-list -->

				</div> <!-- /.wrapper -->
			</div> <!-- /.sidebarOne -->
		</div>
	</div> <!-- /.container -->
</div> <!-- /.blog-details-page -->
