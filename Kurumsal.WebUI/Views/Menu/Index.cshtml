@{

    @model MenuViewModel
    ViewBag.pTitle = "MENÜ LİSTESİ";
    ViewBag.Title = "Menü Listesi";
    ViewBag.pageTitle = "Menüler";
    Layout = "~/Views/_Shared/Layouts/_layout_horizontal_topbarlight_kurumsal_web.cshtml";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">

<div class="row" id="menu-sections">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4">Üst Menü</h4>
                <div class="table-responsive">
                    <table class="table table-centered datatable dt-responsive nowrap" data-bs-page-length="5" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Menü Adı</th>
                                <th class="actions">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody id="menuSection1" ondrop="drop(event)" ondragover="allowDrop(event)">
                            @foreach (var item in Model.Menuler.Where(m => m.MenuYeriId == 1 && m.AnaMenuId == 0))
                            {
                                <tr draggable="true" ondragstart="drag(event)" id="@item.Id">
                                    <td>
                                        @item.Id
                                    </td>
                                    <td>@item.MenuAdi</td>
                                    <td class="actions">
                                        <button class="btn btn-info btn-sm" onclick="editMenu(@item.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-danger btn-sm" onclick="deleteMenu(@item.Id)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                                @foreach (var itemAlt in Model.Menuler.Where(m => m.MenuYeriId == 1 && m.AnaMenuId == item.Id))
                                {
                                    <tr draggable="true" ondragstart="drag(event)" id="@itemAlt.Id">
                                        <td>
                                            -
                                        </td>
                                        <td>@itemAlt.MenuAdi</td>
                                        <td class="actions">
                                            <button class="btn btn-info btn-sm" onclick="editMenu(@itemAlt.Id)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-danger btn-sm" onclick="deleteMenu(@itemAlt.Id)">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-primary menu-add-button" data-bs-toggle="modal" data-bs-target="#menuAddModal" data-menuyeri="1">
                            Menü Ekle
                        </button>
                        <span class="badge bg-primary">@Model.Menuler.Count(m => m.MenuYeriId == 1) Menü</span>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4">Orta Menü</h4>
                <div class="table-responsive">
                    <table class="table table-centered datatable dt-responsive nowrap" data-bs-page-length="5" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Menü Adı</th>
                                <th class="actions">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody id="menuSection2" ondrop="drop(event)" ondragover="allowDrop(event)">

                            @foreach (var item in Model.Menuler.Where(m => m.MenuYeriId == 2 && m.AnaMenuId == 0))
                            {
                                <tr draggable="true" ondragstart="drag(event)" id="@item.Id">
                                    <td>
                                        @item.Id
                                    </td>
                                    <td>@item.MenuAdi</td>
                                    <td class="actions">
                                        <button class="btn btn-info btn-sm" onclick="editMenu(@item.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-danger btn-sm" onclick="deleteMenu(@item.Id)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                                @foreach (var itemAlt in Model.Menuler.Where(m => m.MenuYeriId == 2 && m.AnaMenuId == item.Id))
                                {
                                    <tr draggable="true" ondragstart="drag(event)" id="@itemAlt.Id">
                                        <td>
                                            -
                                        </td>
                                        <td>@itemAlt.MenuAdi</td>
                                        <td class="actions">
                                            <button class="btn btn-info btn-sm" onclick="editMenu(@itemAlt.Id)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-danger btn-sm" onclick="deleteMenu(@itemAlt.Id)">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-primary menu-add-button" data-bs-toggle="modal" data-bs-target="#menuAddModal" data-menuyeri="2">
                            Menü Ekle
                        </button>
                        <span class="badge bg-primary">@Model.Menuler.Count(m => m.MenuYeriId == 2) Menü</span>
                    </div>

                </div>
            </div>
        </div>
    </div>


    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title mb-4">Alt Menü</h4>
                <div class="table-responsive">
                    <table class="table table-centered datatable dt-responsive nowrap" data-bs-page-length="5" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Menü Adı</th>
                                <th class="actions">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody id="menuSection3" ondrop="drop(event)" ondragover="allowDrop(event)">
                            @foreach (var item in Model.Menuler.Where(m => m.MenuYeriId == 3 && m.AnaMenuId == 0))
                            {
                                <tr draggable="true" ondragstart="drag(event)" id="@item.Id">
                                    <td>
                                        @item.Id
                                    </td>
                                    <td>@item.MenuAdi</td>
                                    <td class="actions">
                                        <button class="btn btn-info btn-sm" onclick="editMenu(@item.Id)">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-danger btn-sm" onclick="deleteMenu(@item.Id)">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </td>
                                </tr>
                                @foreach (var itemAlt in Model.Menuler.Where(m => m.MenuYeriId == 3 && m.AnaMenuId == item.Id))
                                {
                                    <tr draggable="true" ondragstart="drag(event)" id="@itemAlt.Id">
                                    <td>
                                            -
                                    </td>
                                        <td>@itemAlt.MenuAdi</td>
                                        <td class="actions">

                                            <button class="btn btn-info btn-sm" onclick="editMenu(@itemAlt.Id)">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-danger btn-sm" onclick="deleteMenu(@itemAlt.Id)">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>


                                        </td>
                                </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-primary menu-add-button" data-bs-toggle="modal" data-bs-target="#menuAddModal" data-menuyeri="3">
                            Menü Ekle
                        </button>
                        <span class="badge bg-primary">@Model.Menuler.Count(m => m.MenuYeriId == 3) Menü</span>
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="menuAddModal" tabindex="-1" aria-labelledby="menuAddModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="menuAddModalLabel">Yeni Menü Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addMenuForm" enctype="multipart/form-data">
                    <input type="hidden" id="menuYeriId" name="Menu.MenuYeriId" value="">
                    <div class="form-group">
                        <label for="AnaMenuId">Ana Menü</label>
                        <select class="form-control" id="menuAnaMenuId" asp-for="Menu.AnaMenuId" name="Menu.AnaMenuId">
                            <option value="0">Kendisi</option>
                            @foreach (var menu in Model.Menuler)
                            {
                                <option value="@menu.Id">@menu.MenuAdi</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="menuName" class="form-label">Menü Adı</label>
                        <input type="text" class="form-control" id="menuName" name="Menu.MenuAdi" required>
                    </div>
                    <div class="mb-3">
                        <label for="menuSira" class="form-label">Sıra</label>
                        <input type="text" class="form-control" id="menuSira" name="Menu.MenuSira" value="1" required>
                    </div>
                    <div class="mb-3">
                        <label for="menuDescription" class="form-label">Menü Açıklaması</label>
                        <textarea class="form-control" id="menuDescription" name="Menu.MenuAciklama"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="menuUrl" class="form-label">Bağlantı Adresi</label>
                        <input type="text" class="form-control" id="menuUrl" name="Menu.BaglantiAdresi">
                    </div>
                    <div class="mb-3">
                        <label for="menuIcon" class="form-label">Menü İkon</label>
                        <input type="text" class="form-control" id="menuIcon" name="Menu.MenuIcon">
                    </div>
                    <div class="mb-3">
                        <label for="menuFile" class="form-label">Menü Görseli</label>
                        <input type="file" class="form-control" id="menuFile" name="Dosya">
                    </div>
                    <div class="mb-3 form-check">
                        <input type="hidden" name="Menu.YeniPenceredeAc" value="false">
                        <input type="checkbox" class="form-check-input" id="newWindow" name="Menu.YeniPenceredeAc" value="true">
                        <label class="form-check-label" for="newWindow">Yeni pencerede aç</label>
                    </div>
                    <button type="submit" class="btn btn-primary">Ekle</button>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- Düzenleme Modalı -->
<div class="modal fade" id="editMenuModal" tabindex="-1" aria-labelledby="editMenuModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editMenuModalLabel">Menü Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editMenuForm" enctype="multipart/form-data">
                    <input type="hidden" id="editMenuId" name="Menu.Id">



                    <div class="form-group">
                        <label for="AnaMenuId">Ana Menü</label>
                        <select class="form-control" id="editMenuAnaMenuId" asp-for="Menu.AnaMenuId" name="Menu.AnaMenuId">
                            <option value="0">Kendisi</option>
                            @foreach (var menu in Model.Menuler)
                            {
                                <option value="@menu.Id">@menu.MenuAdi</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editMenuAdi" class="form-label">Menü Adı</label>
                        <input type="text" class="form-control" id="editMenuAdi" name="Menu.MenuAdi" required>
                    </div>
                    <div class="mb-3">
                        <label for="editMenuSira" class="form-label">Sıra</label>
                        <input type="text" class="form-control" id="editMenuSira" name="Menu.MenuSira" value="1" required>
                    </div>
                    <div class="mb-3">
                        <label for="editMenuAciklama" class="form-label">Menü Açıklaması</label>
                        <textarea class="form-control" id="editMenuAciklama" name="Menu.MenuAciklama"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="editBaglantiAdresi" class="form-label">Bağlantı Adresi</label>
                        <input type="text" class="form-control" id="editBaglantiAdresi" name="Menu.BaglantiAdresi">
                    </div>
                    <div class="mb-3">
                        <label for="editMenuIcon" class="form-label">Menü İkon</label>
                        <input type="text" class="form-control" id="editMenuIcon" name="Menu.MenuIcon">
                    </div>
                    <div class="mb-3">
                        <label for="editMenuFile" class="form-label">Menü Görseli</label>
                        <input type="file" class="form-control" id="editMenuFile" name="Dosya">
                    </div>
                    <div class="mb-3 form-check">
                        <input type="hidden" name="Menu.YeniPenceredeAc" value="false">
                        <input type="checkbox" class="form-check-input" id="newWindow" name="Menu.YeniPenceredeAc" value="true">
                        <label class="form-check-label" for="newWindow">Yeni pencerede aç</label>
                    </div>


                    <!-- Diğer alanlar buraya eklenebilir -->
                    <button type="submit" class="btn btn-primary">Güncelle</button>
                </form>
            </div>
        </div>
    </div>
</div>



<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<!-- JAVASCRIPT -->
<script src="~/assets/libs/jquery/jquery.min.js"></script>
<script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
<script src="~/assets/libs/simplebar/simplebar.min.js"></script>
<script src="~/assets/libs/node-waves/waves.min.js"></script>

<script src="~/assets/js/app.js"></script>
<script>
    $('.menu-add-button').click(function () {
        var menuYeriId = $(this).data('menuyeri');
        $('#menuYeriId').val(menuYeriId);
        // Ana menü seçeneklerini güncelle
        updateAnaMenuOptions(menuYeriId);
    });


    function editMenu(menuId) {
        // Menü bilgilerini sunucudan çek
        fetch(`/Menu/GetMenuById/${menuId}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Form alanlarını doldur
                    $('#editMenuId').val(data.menu.id);
                    $('#editMenuAnaMenuId').val(data.menu.anaMenuId);
                    $('#editMenuYeriId').val(data.menu.menuYeriId);
                    $('#editMenuSira').val(data.menu.menuSira);
                    $('#editMenuAdi').val(data.menu.menuAdi);
                    $('#editMenuAciklama').val(data.menu.menuAciklama);
                    $('#editOtomatikListelemeId').val(data.menu.otomatikListelemeId);
                    $('#editOtomatikListelemeLimiti').val(data.menu.otomatikListelemeLimiti);
                    $('#editMenuIcon').val(data.menu.menuIcon);
                    $('#editBagliSayfaId').val(data.menu.bagliSayfaId);
                    $('#editBaglantiAdresi').val(data.menu.baglantiAdresi);
                    $('#editYeniPenceredeAc').prop('checked', data.menu.yeniPenceredeAc);
                    $('#editDurum').prop('checked', data.menu.durum);

                    // Modalı aç
                    $('#editMenuModal').modal('show');
                } else {
                    Swal.fire('Hata!', 'Menü bilgileri yüklenemedi: ' + data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire('Hata!', 'Sunucu ile bağlantı kurulamadı.', 'error');
            });
    }



    document.getElementById('editMenuForm').addEventListener('submit', function (event) {
        event.preventDefault();
        const formData = new FormData(this);
        fetch('/Menu/UpdateMenu', {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    $('#editMenuModal').modal('hide'); // Modalı kapat
                    Swal.fire('Başarılı!', 'Menü başarıyla güncellendi.', 'success').then(() => {
                        window.location.reload(); // Sayfayı yenile
                    });
                } else {
                    Swal.fire('Hata!', 'Menü güncellenemedi: ' + data.message, 'error');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire('Hata!', 'Sunucu ile bağlantı kurulamadı.', 'error');
            });
    });




    function updateAnaMenuOptions(menuYeriId) {
        // Öncelikle mevcut seçenekleri temizle
        var menuSelect = $('#menuAnaMenuId');
        menuSelect.empty();

        // Seçenekleri sunucudan dinamik olarak yükle veya statik bir listeden filtrele
        $.ajax({
            url: '/Menu/GetAnaMenuOptions', // Sunucu tarafında bu endpoint oluşturulmalı
            type: 'GET',
            data: { menuYeriId: menuYeriId },
            success: function (menus) {

                menuSelect.append($('<option></option>').val('0').text('Kendisi'));

                if (menus.length > 0) {
                    // Her menü öğesi için option elementi ekle
                    menus.forEach(function (menu) {
                        menuSelect.append($('<option></option>').val(menu.id).text(menu.menuAdi));
                    });
                } else {
                    // Eğer menü yoksa, bir placeholder ekle
                    
                }
            },
            error: function () {
                alert('Ana menü seçenekleri yüklenirken hata oluştu.');
            }
        });
    }

    document.getElementById('addMenuForm').addEventListener('submit', function (event) {
        event.preventDefault();
        const formData = new FormData(this);
        fetch('/Menu/AddMenu', {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    Swal.fire({
                        title: 'Başarılı!',
                        text: 'Menü başarıyla eklendi.',
                        icon: 'success',
                        confirmButtonText: 'Tamam'
                    }).then(() => {
                        $('#menuAddModal').modal('hide'); // Modalı kapat
                        window.location.reload(); // Sayfayı yenile
                    });
                } else {
                    Swal.fire({
                        title: 'Hata!',
                        text: 'Menü eklenemedi: ' + data.message,
                        icon: 'error',
                        confirmButtonText: 'Tamam'
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                Swal.fire({
                    title: 'Hata!',
                    text: 'Sunucu ile bağlantı kurulamadı.',
                    icon: 'error',
                    confirmButtonText: 'Tamam'
                });
            });
    });


    function deleteMenu(menuId) {
        Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu menüyü silmek istediğinizden emin misiniz?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Evet, sil!',
            cancelButtonText: 'İptal'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(`/Menu/Delete/${menuId}`, { method: 'POST' })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire(
                                'Silindi!',
                                'Menü başarıyla silindi.',
                                'success'
                            ).then(() => {
                                window.location.reload(); // Sayfayı yenile
                            });
                        } else {
                            Swal.fire(
                                'Hata!',
                                'Menü silinirken bir hata oluştu: ' + data.message,
                                'error'
                            );
                        }
                    })
                    .catch(error => {
                        Swal.fire(
                            'Hata!',
                            'Sunucu ile bağlantı kurulamadı.',
                            'error'
                        );
                    });
            }
        });
    }

</script>



