@model List<Kurumsal.WebUI.Context.AppRole>
@{
    ViewBag.Title = "Basic Tables";
    ViewBag.pTitle = "Basic Tables";
    ViewBag.pageTitle = "Tables";
    Layout = "~/Views/_Shared/_Layout.cshtml";
}


<div class="row">
  
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
     

                <a asp-action="Add" asp-controller="Rol" class="btn btn-info btn-sm my-2" >Yeni Rol Ekle</a>

                <div class="table-responsive">
                    <table class="table table-striped mb-0">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ad</th>
                                <th>İşlemler</th>
                   
                            </tr>
                        </thead>
                        <tbody>


                            @if (Model.Count > 0)
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <th scope="row">-</th>
                                        <td>@item.Name</td>
                                        <td>
                                        
                                            <a asp-action="Update" asp-route-Id="@item.Id" class="btn btn-light"><i class="fa fa-edit"></i></a>
                                            <a asp-action="Delete" asp-route-Id="@item.Id" class="btn btn-light"><i class="fa fa-trash-alt"></i></a>
                                        
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td>Tanımlanmış bir rol bulunamadı!</td>
                                </tr>
                            }





                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>
<!-- end row -->


<!-- JAVASCRIPT -->
<script src="~/assets/libs/jquery/jquery.min.js"></script>
<script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
<script src="~/assets/libs/simplebar/simplebar.min.js"></script>
<script src="~/assets/libs/node-waves/waves.min.js"></script>

<script src="~/assets/js/app.js"></script>
