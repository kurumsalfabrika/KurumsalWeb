@{

    @model SliderViewModel
    ViewBag.pTitle = "SLİDER İŞLEMLERİ";
    ViewBag.Title = "Slider İşlemleri";
    ViewBag.pageTitle = "Sliderler";
    Layout = "~/Views/_Shared/Layouts/_layout_horizontal_topbarlight_kurumsal_web.cshtml";
}
<link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" type="text/css" />
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">

                <form asp-action="AddOrUpdate" method="post" enctype="multipart/form-data">

                    <input type="hidden" id="editSayfaId" asp-for="Slider.Id" name="Slider.Id">

                    <div class="row mb-3">
                        <label for="Sira" class="col-sm-2 col-form-label">Sıra</label>
                        <div class="col-sm-10">
                            <input asp-for="Slider.Sira" type="number" class="form-control">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="Baslik" class="col-sm-2 col-form-label">Başlık/İlk Satır Yazısı</label>
                        <div class="col-sm-10">
                            <input asp-for="Slider.SliderBaslik" class="form-control" placeholder="Slider başlığı">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Baslik" class="col-sm-2 col-form-label">2. Satır Yazisi</label>
                        <div class="col-sm-10">
                            <input asp-for="Slider.IkinciSatir" class="form-control" placeholder="İkinci Satır Yazısı">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Baslik" class="col-sm-2 col-form-label">3. Satır Yazisi</label>
                        <div class="col-sm-10">
                            <input asp-for="Slider.UcuncuSatir" class="form-control" placeholder="Üçüncü Satır Yazısı">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Baslik" class="col-sm-2 col-form-label">4. Satır Yazisi</label>
                        <div class="col-sm-10">
                            <input asp-for="Slider.DorduncuSatir" class="form-control" placeholder="Dördüncü Satır Yazısı">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="ButonYazisi" class="col-sm-2 col-form-label">Buton Yazısı</label>
                        <div class="col-sm-10">
                            <input asp-for="Slider.ButonYazisi" class="form-control" placeholder="Butonda Görünecek Yazı">
                        </div>
                    </div>
                    

                    <div class="row mb-3">
                        <label for="SliderURL" class="col-sm-2 col-form-label">Slider URL</label>
                        <div class="col-sm-10">
                            <input asp-for="Slider.SliderURL" class="form-control" placeholder="Sliderin gideceği URL">
                        </div>
                    </div>

            


                    <div class="row mb-3">
                        <label for="OneCikanGorsel" class="col-sm-2 col-form-label">Öne Çıkan Görsel</label>
                        <div class="col-sm-10">
                            <input type="file" id="oneCikanGorsel" asp-for="Dosya" class="form-control">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="DosyaAdi" class="col-sm-2 col-form-label">Dosya Adı</label>
                        <div class="col-sm-10">
                            <input id="dosyaAdi" asp-for="Slider.OneCikanGorsel" class="form-control">
                        </div>
                    </div>

  
            


                    <div class="row mb-3">
                        <label for="OneCikanGorsel1" class="col-sm-2 col-form-label">Öne Çıkan Görsel 1</label>
                        <div class="col-sm-10">
                            <input type="file" id="oneCikanGorsel1" asp-for="Dosya1" class="form-control">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="DosyaAdi1" class="col-sm-2 col-form-label">Dosya Adı 1</label>
                        <div class="col-sm-10">
                            <input id="dosyaAdi1" asp-for="Slider.OneCikanGorsel1" class="form-control">
                        </div>
                    </div>

  


                    <div class="row mb-3">
                        <label for="OneCikanGorsel2" class="col-sm-2 col-form-label">Öne Çıkan Görsel 2</label>
                        <div class="col-sm-10">
                            <input type="file" id="oneCikanGorsel2" asp-for="Dosya2" class="form-control">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="DosyaAdi2" class="col-sm-2 col-form-label">Dosya Adı 2</label>
                        <div class="col-sm-10">
                            <input id="dosyaAdi2" asp-for="Slider.OneCikanGorsel2" class="form-control">
                        </div>
                    </div>

  

                    <div class="row mb-3">
                        <textarea id="elm1" asp-for="Slider.Aciklama" for="Slider.Aciklama" name="Slider.Aciklama"></textarea>
                    </div>


                    <!-- SEO Açıklama -->
                    <div class="row mb-3">
                        <label for="SEOAciklama" class="col-sm-2 col-form-label">SEO Açıklama</label>
                        <div class="col-sm-10">
                            <input asp-for="Slider.SEOAciklama" class="form-control" placeholder="SEO Açıklama Metni">
                        </div>
                    </div>



                    <!-- SEO Kelimeler -->
                    <div class="row mb-3">
                        <label for="SEOKelimeler" class="col-sm-2 col-form-label">SEO Kelimeler</label>
                        <div class="col-sm-10">
                            <input asp-for="Slider.SEOKelimeler" class="form-control" placeholder="SEO Kelimelerini ,(virgül) ile ayırarak giriniz">
                        </div>
                    </div>



                    <!-- Form Gönderim Butonu -->
                    <div class="row mb-3">
                        <div class="col-sm-10 offset-sm-2">
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </div>



                </form>

            </div>
        </div>
    </div> <!-- end col -->
</div> <!-- end row -->
<!-- JAVASCRIPT -->
<script src="~/assets/libs/jquery/jquery.min.js"></script>
<script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
<script src="~/assets/libs/simplebar/simplebar.min.js"></script>
<script src="~/assets/libs/node-waves/waves.min.js"></script>

<!--tinymce js-->
<script src="~/assets/libs/tinymce/tinymce.min.js"></script>

<!-- init js -->
<script src="~/assets/js/pages/form-editor.init.js"></script>
<!-- Sweet Alerts js -->
<script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>

<!-- Sweet alert init js-->
<script src="~/assets/js/pages/sweet-alerts.init.js"></script>

<script src="~/assets/js/app.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var fileInput = document.getElementById('oneCikanGorsel');
        var fileNameInput = document.getElementById('dosyaAdi');

        fileInput.addEventListener('change', function () {
            if (this.files.length > 0) {
                var fileName = this.files[0].name;

                var fileNameWithoutExtension = fileName.replace(/\.[^/.]+$/, ""); // Uzantıyı kaldır


                fileNameInput.value = fileNameWithoutExtension; // Dosya adını input alanına yerleştir
                // SweetAlert ile bildirim göster
                swal("Dosya Seçildi!", "Dosya Adı alanı SEO açısından büyük önem arz etmektedir. Lütfen dosya adınızı belirlerken özen gösteriniz ve çok fazla uzun olmasın!", "success");
            }
        });

        // Fonksiyonu bir değişkene atayarak kullanıma hazırla
        var showSweetAlert = function () {
            swal({
                title: "Dosya Adı Düzenleme",
                text: "Dosya Adı alanı SEO açısından büyük önem arz etmektedir. Lütfen dosya adınızı belirlerken özen gösteriniz ve çok fazla uzun olmasın!",
                icon: "info",
                button: "Tamam",
            }).then((value) => {
                // SweetAlert gösterildikten sonra, olay dinleyicisini kaldır
                fileNameInput.removeEventListener('click', showSweetAlert);
            });
        };

        // Olay dinleyicisini ekle
        fileNameInput.addEventListener('click', showSweetAlert);
    });

</script>
