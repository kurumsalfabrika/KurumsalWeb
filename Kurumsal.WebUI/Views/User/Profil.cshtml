@{
    ViewBag.Title = "General";
    ViewBag.pTitle = "Profil";
    ViewBag.pageTitle = "Geri";
    Layout = "~/Views/_Shared/_Layout.cshtml";
}
@model UserViewModel
<div class="row">
    <div class="col-xl-6">
        <div class="card">
            <div class="card-body">

                <div class="table-responsive">
              
                    <table class="table table-striped mb-0">
                        <tr>
                            <td>Ad Soyad</td>
                            <td>@Model.Ad @Model.Soyad</td>
                        </tr>

                        <tr>
                            <td>Görevi</td>
                            <td>Elektrik Elektronik Mühendisi</td>
                        </tr>

                        <tr>
                            <td>E-Mail Adresi</td>
                            <td>@Model.Email</td>
                        </tr>

                        <tr>
                            <td>Telefon</td>
                            <td>@Model.Telefon</td>
                        </tr>
                    </table>
                    <a asp-action="Update" asp-controller="User" class="btn btn-success d-grid">Düzenle</a>

                </div>
            </div>
            </div>
    </div>
    <div class="col-xl-6">


                <div class="row justify-content-center">
                    <div class="col-xl-10">
                        <div class="timeline">
                            <div class="timeline-item timeline-left">
                                <div class="timeline-block">
                                    <div class="time-show-btn">
                                        <a href="#" class="btn btn-danger btn-rounded w-lg">2021</a>
                                    </div>
                                </div>
                            </div>

                            <div class="timeline-item">
                                <div class="timeline-block">
                                    <div class="timeline-box card">
                                        <div class="card-body">
                                            <span class="timeline-icon"></span>
                                            <div class="timeline-date">
                                                <i class="mdi mdi-circle-medium circle-dot"></i> 24 Aralık 11:01:05
                                            </div>
                                            <h6 class="mt-3 foont-size-15"> Sisteme giriş yaptınız.</h6>
                             
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="timeline-item timeline-left">
                                <div class="timeline-block">
                                    <div class="timeline-box card">
                                        <div class="card-body">
                                            <span class="timeline-icon"></span>
                                            <div class="timeline-date">
                                                <i class="mdi mdi-circle-medium circle-dot"></i> 24 Aralık 11:20:35
                                            </div>
                                            <h6 class="mt-3 foont-size-15"> AG Mühendislik adında yeni bir proje eklendi.</h6>
                                
                                        </div>
                                    </div>
                                </div>
                            </div>

                        
                        </div>
                    </div>
                </div>

    </div>
</div> <!-- end row -->


<!-- JAVASCRIPT -->
<script src="~/assets/libs/jquery/jquery.min.js"></script>
<script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
<script src="~/assets/libs/simplebar/simplebar.min.js"></script>
<script src="~/assets/libs/node-waves/waves.min.js"></script>

<script src="~/assets/js/app.js"></script>
