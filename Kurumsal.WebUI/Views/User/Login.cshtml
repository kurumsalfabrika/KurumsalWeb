@model UserLoginViewModel
@{
    ViewData["Title"] = "Giriş";
    Layout = "~/Views/_Shared/_BlankLayout.cshtml";
}

<div>
    <div class="container-fluid p-0">
        <div class="row g-0">
            <div class="col-lg-4">
                <div class="authentication-page-content p-4 d-flex align-items-center min-vh-100">
                    <div class="w-100">
                        <div class="row justify-content-center">
                            <div class="col-lg-9">
                                <div>
                                    <div class="text-center">
                                        <div>
                                            <a href=@Url.Action("Index", "Dashboard") class="">
                                           <GirisLogoTag></GirisLogoTag> </a>
                                        </div>

                                        <h4 class="font-size-18 mt-4">Tekrar Hoşgeldiniz !</h4>
                                        <p class="text-muted">Devam etmek için lütfen giriş yapın!</p>
                                    </div>

                                    <div class="p-2 mt-5">
                                        <form asp-action="Login" asp-controller="User"  method="post">

                                            <div class="mb-3 auth-form-group-custom mb-4">
                                                <i class="ri-user-2-line auti-custom-input-icon"></i>
                                                <label for="email">E-Mail</label>
                                                <input type="text" class="form-control" asp-for="Email" id="email" placeholder="E-Mail adresi girin">
                                            </div>

                                            <div class="mb-3 auth-form-group-custom mb-4">
                                                <i class="ri-lock-2-line auti-custom-input-icon"></i>
                                                <label for="userpassword">Şifre</label>
                                                <input type="password" asp-for="Password" class="form-control" id="userpassword" placeholder="Şifrenizi girin">
                                            </div>

                                            <div class="form-check">
                                                <input type="checkbox" asp-for="RememberMe" class="form-check-input" id="customControlInline">
                                                <label class="form-check-label" for="customControlInline">Beni Hatırla</label>
                                            </div>
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <div class="mt-4 text-center">
                                                <button class="btn btn-primary w-md waves-effect waves-light" type="submit">Giriş Yap</button>
                                            </div>

                                            <div class="mt-4 text-center">
                                                <a href=@Url.Action("SifremiUnuttum", "User") class="text-muted"><i class="mdi mdi-lock me-1"></i> Şifremi unuttum?</a>
                                            </div>
                                        </form>
                                    </div>

                                    <div class="mt-5 text-center">

                                        <p>
                                            ©
                                            <script>document.write(new Date().getFullYear())</script> Kurumsal Fabrika. CRM Panel
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="authentication-bg">
                    <div class="bg-overlay"></div>
                </div>
            </div>
        </div>
    </div>
</div>
