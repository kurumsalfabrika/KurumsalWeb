@model AcilirMesajViewModel
@{
    ViewBag.Title = "Açılır Mesaj Yönetimi";
    ViewBag.pTitle = "Açılır Mesaj Yönetimi";
    ViewBag.pageTitle = "Geri";
    Layout = "~/Views/_Shared/_Layout.cshtml";
}

@section styles
    {
    <link href="~/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css">
}
<link href="~/assets/libs/bootstrap-datepicker/css/bootstrap-datepicker.min.css" rel="stylesheet">
<link href="~/assets/libs/spectrum-colorpicker2/spectrum.min.css" rel="stylesheet" type="text/css">
<link href="~/assets/libs/bootstrap-touchspin/jquery.bootstrap-touchspin.min.css" rel="stylesheet">



<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <form asp-action="AddOrUpdate" asp-controller="AcilirMesaj" method="post">
                    <div class="row">
                        <div class="sub-heading">
                            <span>Mesaj Bilgileri</span>
                        </div>
                        <div class="col-lg-6 mb-3">
                            <input type="hidden" id="input-id" asp-for="@Model.AcilirMesaj.Id" class="form-control">
                            <label class="form-label" for="input-ad">Mesaj Adı:</label>
                            <span asp-validation-for="@Model.AcilirMesaj.MesajAdi" class="text-danger"></span>
                            <input id="input-ad" type="tex" asp-for="@Model.AcilirMesaj.MesajAdi" class="form-control">
                        </div>
                    
                        <div class="col-lg-6 mb-3">
                            <label class="form-label" for="input-logo">Açılır Mesaj Resmi:</label>
                            <div class="input-group">
                                <input type="file" class="form-control" id="customFile">
                            </div>
                        </div>

                        <div class="col-lg-12 mb-3">
                         <label class="form-label" for="input-aciklama">Açıklama:</label>
                            <span asp-validation-for="@Model.AcilirMesaj.Aciklama" class="text-danger"></span>
                            <textarea id="elm1" name="area" asp-for="@Model.AcilirMesaj.Aciklama"></textarea>
                        </div>


                        <div class="col-lg-4 mb-3">
                            <div class="form-check form-switch mb-3" dir="ltr">
                                <input type="checkbox" asp-for="@Model.AcilirMesaj.ZamanAyarli" class="form-check-input" id="customSwitch1">
                                <label class="form-check-label" for="customSwitch1">Zaman Ayarlı</label>
                            </div>
                        </div>

                        <div class="col-lg-4 mb-3">
                            <label class="form-label" for="input-ad">Başlama Zamanı:</label>
                            <span asp-validation-for="@Model.AcilirMesaj.BaslamaTarihi" class="text-danger"></span>
                            <input id="input-ad" type="datetime" asp-for="@Model.AcilirMesaj.BaslamaTarihi" class="form-control">
                        </div>


                        <div class="col-lg-4 mb-3">
                            <label class="form-label" for="input-ad">Bitiş Zamanı:</label>
                            <span asp-validation-for="@Model.AcilirMesaj.BitisTarihi" class="text-danger"></span>
                            <input id="input-ad" type="datetime" asp-for="@Model.AcilirMesaj.BitisTarihi" data-inputmask="'alias': 'datetime'" class="form-control">
                        </div>


                        <div class="col-lg-12 mb-3">
                            <div class="panel panel-danger tospanel">
                                <div class="panel-heading">
                                    <h3 class="panel-title"><span class="fas fa-exclamation-triangle tosicon"></span> &nbsp; Kullanım Koşulları</h3>
                                </div>
                                <div class="panel-body">
                                    <div class="col-md-12">
                                        <label class="checkbox">
                                            <input type="checkbox" name="accepttos" class="accepttos">
                                            Kullanım Koşullarını ve ilgili Sözleşmeyi okudum ve anladım. <a href="hakkimizda/hizmet-sozlesmesi" target="_blank">Kullanım Koşulları</a>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-danger" asp-validation-summary="ModelOnly"></div>
                        <div class="col-lg-12 mb-3">
                            <input type="submit" class="btn btn-primary btn-sm" value="Kaydet" />
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- end row -->
<!-- JAVASCRIPT -->
<script src="~/assets/libs/jquery/jquery.min.js"></script>
<script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/assets/libs/metismenu/metisMenu.min.js"></script>
<script src="~/assets/libs/simplebar/simplebar.min.js"></script>
<script src="~/assets/libs/node-waves/waves.min.js"></script>

<script src="~/assets/libs/select2/js/select2.min.js"></script>
<script src="~/assets/libs/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
<script src="~/assets/libs/spectrum-colorpicker2/spectrum.min.js"></script>
<script src="~/assets/libs/bootstrap-touchspin/jquery.bootstrap-touchspin.min.js"></script>
<script src="~/assets/libs/admin-resources/bootstrap-filestyle/bootstrap-filestyle.min.js"></script>
<script src="~/assets/libs/bootstrap-maxlength/bootstrap-maxlength.min.js"></script>

<script src="~/assets/js/pages/form-advanced.init.js"></script>

<script src="~/assets/libs/tinymce/tinymce.min.js"></script>

<!-- init js -->
<script src="~/assets/js/pages/form-editor.init.js"></script>
<!-- form mask -->
<script src="~/assets/libs/inputmask/jquery.inputmask.min.js"></script>
<!-- form mask init -->
<script src="~/assets/js/pages/form-mask.init.js"></script>
<!--tinymce js-->




<script src="~/assets/js/app.js"></script>