                                    <ol class="breadcrumb m-0">
                                        <li class="breadcrumb-item"><a href="javascript: history.back();">@ViewBag.pageTitle</a></li>
                                        <li class="breadcrumb-item active">@ViewBag.pTitle</li>
                                    </ol>
                                </div>

                            </div>
                        </div>
                    </div>
                    <!-- end page title -->
                    @RenderBody()
                </div>
            </div>
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <script>document.write(new Date().getFullYear())</script> © Kurumsal Fabrika.
                        </div>
                        <div class="col-sm-6">
                            <div class="text-sm-end d-none d-sm-block">
                                AG Plan Proje Mühendislik İnşaat San ve Tic. Ltd. Şti. Kalan Süre (245 gün)
                            </div>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    <!-- Right Sidebar -->
    <div class="right-bar">
        <div data-simplebar class="h-100">
            <div class="rightbar-title d-flex align-items-center px-3 py-4">

                <h5 class="m-0 me-2">Görünüm</h5>

                <a href="javascript:void(0);" class="right-bar-toggle ms-auto">
                    <i class="mdi mdi-close noti-icon"></i>
                </a>
            </div>

            <!-- Settings -->
            <hr class="mt-0" />
            <h6 class="text-center mb-0">Görünüm Değiştir</h6>

            <div class="p-4">
                <div class="mb-2">
                    <img src="~/assets/images/layouts/layout-1.jpg" class="img-fluid img-thumbnail" alt="layout-1">
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input theme-choice" type="checkbox" id="light-mode-switch" checked>
                    <label class="form-check-label" for="light-mode-switch">Açık Mod</label>
                </div>

                <div class="mb-2">
                    <img src="~/assets/images/layouts/layout-2.jpg" class="img-fluid img-thumbnail" alt="layout-2">
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input theme-choice" type="checkbox" id="dark-mode-switch" data-bsStyle="~assets/css/bootstrap-dark.min.css" data-appStyle="~assets/css/app-dark.min.css">
                    <label class="form-check-label" for="dark-mode-switch">Koyu Mod</label>
                </div>

                <div class="mb-2">
                    <img src="~/assets/images/layouts/layout-3.jpg" class="img-fluid img-thumbnail" alt="layout-3">
                </div>
                <div class="form-check form-switch mb-5">
                    <input class="form-check-input theme-choice" type="checkbox" id="rtl-mode-switch" data-appStyle="~assets/css/app-rtl.min.css">
                    <label class="form-check-label" for="rtl-mode-switch">RTL Mod</label>
                </div>
            </div>
        </div> 
    </div>
    <div class="rightbar-overlay"></div>
    @RenderSection("scripts", required: false)
</body>
</html>