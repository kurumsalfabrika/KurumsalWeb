@using Kurumsal.Core.Functions
@model HizmetViewModel
<section class="page-header">
    <div class="page-header__bg" style="background-image: url(~/assets/images/backgrounds/page-header-bg.jpg);"></div><!-- /.page-header__bg -->
    <div class="container">
        <div class="page-header__content">
            <h2 class="page-header__title">@Model.Hizmet.HizmetAdi</h2>
            <ul class="insuba-breadcrumb list-unstyled">
                <li><a href="/anasayfa/3asosgb.html">Anasayfa</a></li>
                <li><span>@Model.Hizmet.HizmetAdi</span></li>
            </ul>
        </div>
    </div>
    @if (string.IsNullOrEmpty(Model.Hizmet.OneCikanGorsel))
    {
        <img src="~/assets/images/resources/page-header-1-1.png" alt="3 AS Ortak Sağlık Güvenlik Birimi" class="page-header__image" />
    }
    else
    {
        <img src="@($"{Model.Ftp.DosyaAdresOnEki}{Model.Hizmet.OneCikanGorsel}")" alt="3 AS Ortak Sağlık Güvenlik Birimi" class="page-header__image" />
    }
    <div class="page-header__shape-two"></div>
    <div class="page-header__shape-three"></div>
    <div class="page-header__shape-four"></div><
</section>

<section class="about-one about-one--about section-space">
    <div class="container">
        <div class="row gutter-y-50 align-items-center">
            <div class="col-lg-12">
                @Html.Raw(Model.Hizmet.Icerik)
            </div>
        </div>
    </div>
</section>
