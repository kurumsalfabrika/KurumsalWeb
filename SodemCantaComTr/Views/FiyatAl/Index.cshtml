                <div class="row">

                    <div class="col-lg-3 col-6">
                        <img src="@Model.Ftp.DosyaAdresOnEki@("canta/2020.jpg")" alt="20x20 Baskı Alanı"  class="img-fluid zoom-effect" onclick="selectTemplate('@Model.Ftp.DosyaAdresOnEki@("canta/2020.jpg")')">
