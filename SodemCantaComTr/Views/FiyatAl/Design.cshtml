@model FiyatAlViewModel

@section Styles {
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/menu.css" rel="stylesheet">
    <link href="~/css/responsive.css" rel="stylesheet">
    <link href="~/css/elegant_font/elegant_font.min.css" rel="stylesheet">
    <link href="~/css/fontello/css/fontello.min.css" rel="stylesheet">
    <link href="~/css/magnific-popup.min.css" rel="stylesheet">
    <link href="~/css/bs-icon-font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/skins/square/grey.css" rel="stylesheet">
    <script src="~/js/modernizr.js"></script>
    <link href="~/css/shop.css" rel="stylesheet">
    <link href="~/css/custom.css" rel="stylesheet">




}
<section class="parallax_window_in short" data-image-src="https://www.sodemcanta.com.tr/img/header_bg_black.jpg" data-parallax="scroll" data-natural-width="1400" data-natural-height="350">
    <div id="sub_content_in">
        <div class="container">
            <h1>Fiyat Al / DESİGN</h1>
            <p>"Çanta için tasarımı burada yapabilirsiniz"</p>
        </div>
    </div>
</section>
<main>
    <div class="container margin_60_35">
        <div class="text-center mb-4">
            <h3>Tasarıma Başlayabilirsiniz</h3>
        </div>
        <div class="col-lg-12">
            <div class="row">
                <div class="col-lg-8">
                    <canvas id="canvas" class="img-fluid"></canvas>
                </div>
                <div class="col-lg-4">

                    <div class="form-group">
                        <label>Tasarıma Eklemek İstediğiniz Metin</label>
                        <input type="text" class="form-control" id="textInput" placeholder="Eklenecek Metin">
                        <button class="btn btn-success" onclick="addText()">Metin Ekle</button>
                    </div>

                    <div class="form-group">
                        <label>Eklenecek Resim</label>
                        <input type="file" class="form-control"  id="fileInput">
                        <button class="btn btn-success" onclick="addImage()">Resim Ekle</button>
                    </div>
                    <div class="form-group">
                    <p>- Tasarım hazırlanırken sınırsız metin eklenebilir. Metin alanına yazılan metin metin ekle butonuna basılarak tasarım alanına eklenir.</p>
                    <p>- Resim eklemek için de önce gözat denilir ve resim seçilir, daha sonra resim ekle butonuna basılır ve tasarım alanına eklenir. İstediğiniz kadar ekleyebilirsiniz.</p>
                    <p>- Herhangi bir nesneyi silmek için tasarım alanından seçilir ve del tuşuna basılır.</p>
                    <p>- Tasarım işlemi bittikten sonra Kaydet ve İlerle butonuna basılır. Gelen sayfada istenen bilgiler doldurulur.</p>
                    </div>
                    <div class="form-group">
                        <button class="btn btn-danger" onclick="saveDesignAsJPG()">Kaydet ve İlerle</button>
                    </div>

                    <div class="form-group">
                        <button class="btn btn-danger" onclick="downloadDesignAsJPG()">Kaydet ve İndir</button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/common_scripts_min.js"></script>
    <script src="~/js/functions.js"></script>
    <script src="~/js/fontawesome.init.js"></script>

    <!-- Form validation -->
    <script src="~/assets/validate.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/4.5.0/fabric.min.js"></script>
    <script src="~/js/scripts-fiyatal.js"></script>
}
