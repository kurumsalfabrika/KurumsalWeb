@using Kurumsal.Core.Functions
@model ReferansViewModel

@section Styles {

    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/menu.css" rel="stylesheet">
    <link href="~/css/responsive.css" rel="stylesheet">
    <link href="~/css/elegant_font/elegant_font.min.css" rel="stylesheet">
    <link href="~/css/fontello/css/fontello.min.css" rel="stylesheet">
    <link href="~/css/magnific-popup.min.css" rel="stylesheet">
    <link href="~/css/bs-icon-font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/skins/square/grey.css" rel="stylesheet">
    <script src="~/js/modernizr.js"></script>
    <link href="~/css/shop.css" rel="stylesheet">
    <link href="~/css/custom.css" rel="stylesheet">
}

<section class="parallax_window_in short" data-parallax="scroll" data-image-src="https://www.sodemcanta.com.tr/img/header_bg_black.jpg" data-natural-width="1400" data-natural-height="350">
    <div id="sub_content_in">
        <div class="container">
            <h1 style="margin-bottom: 40px;">Referanslar</h1>
        </div>
    </div>
</section><!-- End section -->

<main>
    <div class="container margin_60_35">
        <div class="row">
            <div class="col-lg-12">
                <div class="container">
                    <div class="row">
                        <div class="row">
                            @if (Model.Referanslar == null || !Model.Referanslar.Any())
                            {
                                <div class="alert alert-warning" role="alert">
                                    Ürün bulunamadı.
                                </div>
                            }
                            else
                            {
                                @foreach (var item in Model.Referanslar)
                                {
                                    <div class="col-12 col-md-3" style="padding:5px;">
                                        <img src="@Model.Ftp.DosyaAdresOnEki@("k_" + item.OneCikanGorsel)" alt="" class="img-fluid zoom-effect bordered-image">
                                    </div>

                                    <style>
                                        .bordered-image {
                                            border: 2px solid lightgrey;
                                            padding: 5px;
                                        }
                                    </style>

                                }
                            }
                        </div><!-- End row-->
                    </div><!-- End row -->
                </div>
            </div><!-- End col-lg-9 -->

        </div><!-- End row -->
    </div><!-- End container -->
</main><!-- End main -->
@section Modals {

}

@section Scripts {
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/common_scripts_min.js"></script>
    <script src="~/js/functions.js"></script>
    <script src="~/js/fontawesome.init.js"></script>
}
