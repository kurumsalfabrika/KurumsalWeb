@model FiyatAlViewModel

@section Styles {
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/menu.css" rel="stylesheet">
    <link href="~/css/responsive.css" rel="stylesheet">
    <link href="~/css/elegant_font/elegant_font.min.css" rel="stylesheet">
    <link href="~/css/fontello/css/fontello.min.css" rel="stylesheet">
    <link href="~/css/magnific-popup.min.css" rel="stylesheet">
    <link href="~/css/bs-icon-font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/skins/square/grey.css" rel="stylesheet">
    <script src="~/js/modernizr.js"></script>
    <link href="~/css/shop.css" rel="stylesheet">
    <link href="~/css/custom.css" rel="stylesheet">
    }
<section class="parallax_window_in short" data-parallax="scroll" data-image-src="img/subheader_in_3.jpg" data-natural-width="1400" data-natural-height="350">
    <div id="sub_content_in">
        <div class="container">
            <h1>Fiyat Al / DESİGN</h1>
            <p>"Çanta için tasarımı burada yapabilirsiniz"</p>
        </div>
    </div>
</section>
<main>
    <div class="container margin_60_35">
        <div class="text-center mb-4">
            <span>Tasarıma Başlayabilirsiniz</span>
        </div>


        <div class="row">

            <div class="col-lg-12 mt-lg-0">

                <!-- <center>
                  <div class="form-group fabric-canvas-wrapper">
                    <canvas id="c" height="300" style="border:1px solid #ccc;"></canvas>
                  </div>
                </center> -->

                <div style="background-image: url(@Url.Content($"~/cantalar/{Model.FiyatAl.SecilenResim}.png")); height: 100%; width: 100%;background-size: 100% 100%;" id="sini_div_baju_color">
                    <div style="height: 20%; width: 100%;background-size: 100% 100%;"></div>
                    <div id="sini_div_canvas" style="height: 200px; width: 400px;background-size: 100% 100%;  position: center; margin: auto;">
                        <div class="form-group fabric-canvas-wrapper" style="height: 100%">
                            <canvas id="c" style="border:1px solid #ccc;"></canvas>
                        </div>
                    </div>
                </div>

                <br>

                <div class="form-group">
                    <select class="form-control pacific" onchange="change_editor(value)" id="editor_select">
                        <option selected="" disabled="">-Editör Seçiniz-</option>
                        <option value="bentuk">Dikdörtgen Şekil</option>
                        <option value="teks">Metin</option>
                        <option value="drawing">Serbest Çizim</option>
                        <option value="image">Görsel</option>
                    </select>
                </div>

                <div id="sini_div_editor"></div>

                <div id="sini_tampung_image" style="display: none;"></div>

                <div id="div_upload_image" style="display: none">
                    <div class="form-group">
                        <label class="pacific">Görsel Yükle</label>
                        <input class="form-control" type="file" id="input_upload_image">
                    </div>
                    <div class="form-group" style="text-align:center">
                        <button onclick="add_image()" class="btn btn-info pacific" style="font-weight: bold;">Görsel Ekle</button>
                    </div>
                </div>

                <center>
                    <button id="save_datanya11" onclick="save_desain()" class="pacific btn btn-success" style="font-weight: bold;" disabled="">Tasarruf</button>
                </center>
                <center><button onclick="cek_simpanan()" class="btn btn-success" style="font-weight: bold;">Kaydedilenleri Kontrol Et</button></center>

            </div>

        </div>



    </div>
</main>

@section Scripts {
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/common_scripts_min.js"></script>
    <script src="~/js/functions.js"></script>
    <script src="~/js/fontawesome.init.js"></script>

    <!-- Form validation -->
    <script src="~/assets/validate.js"></script>

}
