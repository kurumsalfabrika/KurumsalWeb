@model FiyatAlViewModel

@section Styles {
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/menu.css" rel="stylesheet">
    <link href="~/css/responsive.css" rel="stylesheet">
    <link href="~/css/elegant_font/elegant_font.min.css" rel="stylesheet">
    <link href="~/css/fontello/css/fontello.min.css" rel="stylesheet">
    <link href="~/css/magnific-popup.min.css" rel="stylesheet">
    <link href="~/css/bs-icon-font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/skins/square/grey.css" rel="stylesheet">
    <script src="~/js/modernizr.js"></script>
    <link href="~/css/shop.css" rel="stylesheet">
    <link href="~/css/custom.css" rel="stylesheet">
    <style>
        .ic-kutu {
            position: relative;
            border-radius: 3px;
            border: 1px solid lightgray;
            padding: 5px;
            margin: 5px;
            box-sizing: border-box;
            height: 100%;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
        }

        .image-frame {
            max-width: 100%;
            max-height: 100%;
            display: block;
        }

        .image-label {
            position: absolute;
            bottom: 10px;
            right: 10px;
            background-color: #ffd700;
            border-radius: 3px;
            border: 1px solid lightgray;
            padding: 2px 5px;
            font-size: 14px;
        }
    </style>
}
<section class="parallax_window_in short" data-parallax="scroll" data-image-src="img/subheader_in_3.jpg" data-natural-width="1400" data-natural-height="350">
    <div id="sub_content_in">
        <div class="container">
            <h1>Fiyat Al</h1>
            <p>"Aşağıdaki çanta ölçülerinden ilgili çantayı seçerek devam edebilirsiniz."</p>
        </div>
    </div>
</section>
<main>
    <div class="container margin_60_35">
        <div class="text-center mb-4">
            <h2>Fiyat almak istediğiniz çantayı seçiniz</h2>
        </div>
        <div class="row">
            <div class="col-lg-3 col-md-3 col-sm-6">
                <div class="ic-kutu">
                    <a href="/fiyatal2/urun-1.html" title="Ürün seçimi">
                        <img src="~/cantalar/1.png" height="250" class="image-frame" />
                    </a>
                    <div class="image-label">20cm*20cm</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6">
                <div class="ic-kutu">
                    <img src="~/cantalar/2.png" height="270" class="image-frame" />
                    <div class="image-label">20cm*25cm</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6">
                <div class="ic-kutu">
                    <img src="~/cantalar/3.png" height="290" class="image-frame" />
                    <div class="image-label">25cm*30cm</div>
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6">
                <div class="ic-kutu">
                    <img src="~/cantalar/4.png" height="305" class="image-frame" />
                    <div class="image-label">30cm*35cm</div>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="ic-kutu">
                    <img src="~/cantalar/5.png" height="315" class="image-frame" />
                    <div class="image-label">30cm*40cm</div>
                </div>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="ic-kutu">
                    <img src="~/cantalar/6.png" height="315" class="image-frame" />
                    <div class="image-label">40cm*40cm</div>
                </div>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="ic-kutu">
                    <img src="~/cantalar/7.png" height="315" class="image-frame" />
                    <div class="image-label">50cm*40cm</div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/common_scripts_min.js"></script>
    <script src="~/js/functions.js"></script>
    <script src="~/js/fontawesome.init.js"></script>

    <!-- Form validation -->
    <script src="~/assets/validate.js"></script>

    <script>
        function selectBag(size, imagePath) {
            $.ajax({
                url: '@Url.Action("SelectBag", "FiyatAl")',
                type: 'POST',
                data: { size: size, imagePath: imagePath },
                success: function (response) {
                    window.location.href = 'nextPageUrl';
                },
                error: function (error) {
                    console.error("Error:", error);
                }
            });
        }
    </script>
}
