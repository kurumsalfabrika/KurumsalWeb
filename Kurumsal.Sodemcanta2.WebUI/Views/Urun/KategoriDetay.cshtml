@using Kurumsal.Core.Functions
@model UrunViewModel

@section Styles {

    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/menu.css" rel="stylesheet">
    <link href="~/css/responsive.css" rel="stylesheet">
    <link href="~/css/elegant_font/elegant_font.min.css" rel="stylesheet">
    <link href="~/css/fontello/css/fontello.min.css" rel="stylesheet">
    <link href="~/css/magnific-popup.min.css" rel="stylesheet">
    <link href="~/css/bs-icon-font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/skins/square/grey.css" rel="stylesheet">
    <script src="~/js/modernizr.js"></script>
    <link href="~/css/shop.css" rel="stylesheet">
    <link href="~/css/custom.css" rel="stylesheet">
    <style>
        #productModal {
            z-index: 100050; /* Varsayılan Bootstrap z-index değeri */
        }
    </style>
}

<section class="parallax_window_in short" data-parallax="scroll" data-image-src="@Model.Ftp.DosyaAdresOnEki@Model.UrunKategori.OneCikanGorsel" data-natural-width="1400" data-natural-height="350">
    <div id="sub_content_in">
        <div class="container">
            <h1 style="margin-bottom: 40px;">@Model.UrunKategori.KategoriAdi</h1>
        </div>
    </div>
</section><!-- End section -->

<main>
    <div class="container margin_60_35">
        <div class="row">
            <div class="col-lg-9">
                <!-- Soldaki 9 birimlik sütun -->
                <div class="container">
                    <div class="row">
                        <div class="row">
                            @if (Model.Urunler == null || !Model.Urunler.Any())
                            {
                                <div class="alert alert-warning" role="alert">
                                    Ürün bulunamadı.
                                </div>
                            }
                            else
                            {
                                @foreach (var item in Model.Urunler)
                                {
                                    <div class="col-6 col-md-3">
                                        <a href="#" title="@item.UrunKodu" data-bs-toggle="modal" data-bs-target="#productModal" data-id="@item.Id" data-title="@item.UrunKodu" data-image="@Model.Ftp.DosyaAdresOnEki@item.OneCikanGorsel" data-description="@item.Icerik">
                                            <img src="@Model.Ftp.DosyaAdresOnEki@("k_" + item.OneCikanGorsel)" alt="" class="img-fluid zoom-effect">
                                        </a>
                                        <br />
                                        <p style="text-align: center;">
                                            <a class="product-link" href="@Url.Content("~/urun/" + SeoUrlGenerator.GenerateSlug(item.UrunKodu) + "-" + SeoUrlGenerator.GenerateSlug(Model.UrunKategori.KategoriAdi) + "-" + item.Id + ".html")" target="_self">@item.UrunKodu</a>
                                        </p>
                                    </div>
                                }
                            }
                        </div><!-- End row-->
                    </div><!-- End row -->
                </div>
            </div><!-- End col-lg-9 -->

            <div class="col-lg-3">
                <aside class="sidebar">
                    <!-- En sağdaki 3 birimlik sütun -->
                    <div class="widget" id="cat_shop">
                        <h4>Kategoriler</h4>
                        <ul>
                            @foreach (var item in Model.UrunKategoriler.Where(x => x.UstKategoriId == null))
                            {
                                <li><a href="@Url.Content("~/urunkategori/" + SeoUrlGenerator.GenerateSlug(item.KategoriAdi) + "-" + item.Id + ".html")">@item.KategoriAdi</a></li>
                                @foreach (var altitem in Model.UrunKategoriler.Where(x => x.UstKategoriId == item.Id))
                                {
                                    <li><a href="@Url.Content("~/urunkategori/" + SeoUrlGenerator.GenerateSlug(altitem.KategoriAdi) + "-" + altitem.Id + ".html")">-> @altitem.KategoriAdi</a></li>
                                }
                            }
                        </ul>
                    </div><!-- End widget -->
                </aside>
                <!-- İçerik buraya gelecek -->
            </div><!-- End col-lg-3 -->
        </div><!-- End row -->
    </div><!-- End container -->
</main><!-- End main -->
@section Modals {
    <div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productModalLabel">Ürün Detayları</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <img id="modal-image" src="" alt="" class="img-fluid">
                    <hr />
                    <p id="modal-description"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <script src="~/js/common_scripts_min.js"></script>
    <script src="~/js/functions.js"></script>
    <script src="~/js/fontawesome.init.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', (event) => {
            var productModal = document.getElementById('productModal');
            productModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget; // Modal'i açan buton
                var productId = button.getAttribute('data-id');
                var productTitle = button.getAttribute('data-title');
                var productImage = button.getAttribute('data-image');
                var productDescription = button.getAttribute('data-description');

                // Modal başlığını ve içeriğini güncelle
                var modalTitle = productModal.querySelector('.modal-title');
                var modalImage = productModal.querySelector('#modal-image');
                var modalDescription = productModal.querySelector('#modal-description');

                modalTitle.textContent = productTitle;
                modalImage.src = productImage;
                modalDescription.innerHTML = productDescription;
            });
        });
    </script>
}
