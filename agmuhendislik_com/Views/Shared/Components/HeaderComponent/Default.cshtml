@model GenelViewModel

<div class="menu-area">
    <div class="container">
        <div class="row align-items-center justify-content-between">
            <div class="col-auto">
                <div class="header-logo">
                    <a href="index.html">
                        <img src="assets/img/logo-white.svg" alt="Builda">
                    </a>
                </div>
            </div>
            <div class="col-auto">
                <nav class="main-menu d-none d-lg-inline-block">
                    <ul>



                        @foreach (var item in Model.Menuler.Where(x => x.AnaMenuId == 0).ToList())
                        {
                            @if (Model.Menuler.Where(a => a.AnaMenuId == item.Id).Count() == 0)
                            {
                                <li><a href="@item.BaglantiAdresi">@item.MenuAdi</a></li>
                            }
                            else
                            {
                                <li class="menu-item-has-children">
                                    <a href="#" >@item.MenuAdi</a>
                                    <ul class="sub-menu">
                                        @foreach (var altitem in Model.Menuler.Where(c => c.AnaMenuId == item.Id))
                                        {
                                            <li><a href="@altitem.BaglantiAdresi">@altitem.MenuAdi </a></li>
                                        }
                                    </ul>
                                </li>
                            }
                        }



                    </ul>
                </nav>
                <div class="header-button d-flex d-lg-none">
                    <button type="button" class="th-menu-toggle sidebar-btn bg-transparent">
                        <span class="line"></span>
                        <span class="line"></span>
                        <span class="line"></span>
                    </button>
                </div>
            </div>
            <div class="col-auto d-none d-xxl-block">
                <div class="header-button">
                    <a href="contact.html" class="th-btn style4 th-btn-icon">Teklif</a>
                    <button type="button" class="simple-icon sideMenuInfo sidebar-btn">
                        <span class="line"></span>
                        <span class="line"></span>
                        <span class="line"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>