@using Kurumsal.Core.Functions
@model GenelViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}
<!--==============================
Hero Area
==============================-->
<div class="th-hero-wrapper hero-12" id="hero">
    <div class="slider-area">
        <div class="swiper hero-slider12" id="heroSlide12">
            <div class="swiper-wrapper">


                @foreach (var item in Model.Sliderlar)
                {
                    <div class="swiper-slide">
                        <div class="th-hero-bg" data-overlay="title" data-opacity="1" data-bg-src="@Model.Ftp.DosyaAdresOnEki@item.OneCikanGorsel"><img src="@Model.Ftp.DosyaAdresOnEki@item.OneCikanGorsel" alt="@item.SliderBaslik"></div>
                        <div class="container">
                            <div class="hero-style12 text-center">
                                <h4 class="hero-subtitle text-theme fw-medium" data-ani="slideinup" data-ani-delay="0.2s">@item.SliderBaslik</h4>
                                <h1 class="hero-title text-white">
                                    <span class="title" data-ani="slideinup" data-ani-delay="0.2s">
                                       @item.IkinciSatir
                                    </span>
                                    <span class="title" data-ani="slideinup" data-ani-delay="0.4s">
                                        @item.UcuncuSatir
                                    </span>
                                </h1>
                                <div class="btn-wrap justify-content-center" data-ani="slideinup" data-ani-delay="0.6s">
                                    <a href="@item.SliderURL" class="th-btn style4 th-btn-icon">@item.ButonYazisi</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
        <button class="slider-arrow slider-prev swiper-button-prev">
            <img src="assets/img/icon/arrow-left.svg" alt="img">
            <span class="circle-tag">
                <span class="about-experience-tag">
                    <span class="circle-title-anime">YOUR DREAM PLACE EXPLORE AND FIND</span>
                </span>
            </span>
        </button>
        <button class="slider-arrow slider-next swiper-button-next">
            <img src="assets/img/icon/arrow-right.svg" alt="img">
            <span class="circle-tag">
                <span class="about-experience-tag">
                    <span class="circle-title-anime">YOUR DREAM PLACE EXPLORE AND FIND</span>
                </span>
            </span>
        </button>
    </div>
</div>
<div class="hero-scroll-down12">
    <div class="scroll-down">
        <a href="#about-sec" class="hero-scroll-wrap"></a>
    </div>
</div>
<!--======== / Hero Section ========-->