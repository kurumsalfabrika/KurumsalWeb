    <!--Color Themes-->
    <link id="theme-color-file" href="~/css/color-themes/red-theme.css" rel="stylesheet">
}
<section class="page-title" style="background-image:url(images/background/5.jpg);">
    <div class="auto-container">
        <div class="inner-box">
            <h1>Bizimle İletişime Geçin</h1>
            <ul class="bread-crumb">
                <li><a href="/anasayfa/anasayfa.html">Anasayfa</a></li>
                <li>İletişim</li>
            </ul>
        </div>
    </div>
</section>


<!--Contact Section-->
<section class="contact-page-section">
    <div class="auto-container">
        <div class="row clearfix">
            <!--Form Column-->
            <div class="column form-column col-md-8 col-sm-12 col-xs-12">
                <div class="inner-column">
                    <h2>İletişime Geçin</h2>
                    <div class="text">Aşağıdaki formu kullanarak bizimle hızlı bir şekilde iletişime geçebilirsiniz.</div>

                    <!--Contact Form-->
                    <div class="contact-form">
                        <form method="post" action="sendemail.php" id="contact-form">
                            <div class="row clearfix">
                                <div class="form-group col-md-6 col-sm-6 col-xs-12">
                                    <input type="text" name="fname" value="" placeholder="Ad Soyad" required>
                                </div>
                                <div class="form-group col-md-6 col-sm-6 col-xs-12">
                                    <input type="email" name="email" value="" placeholder="Email" required>
                                </div>
                                <div class="form-group col-md-12 col-sm-12 col-xs-12">
                                    <input type="text" name="subject" value="" placeholder="Konu" required>
                                </div>
                                <div class="form-group col-md-12 col-sm-12 col-xs-12">
                                    <textarea name="message" placeholder="Mesaj"></textarea>
                                </div>

                                <div class="form-group col-md-12 col-sm-12 col-xs-12 text-right">
                                    <button type="submit" class="theme-btn btn-style-one">Gönder</button>
                                </div>

                            </div>

                        </form>
                    </div>

                </div>
            </div>
            <!--Info Column-->
            <div class="column info-column col-md-4 col-sm-12 col-xs-12">
                <div class="inner-column">
                    <h2>İletişim Bilgileri</h2>
                    <div class="text">Aşağıdaki iletişim bilgilerini kullanarak bizimle iletişime geçebilirsiniz.</div>
                    <div class="information-blocks">
                        <!--Contact Info-->
                        <div class="contact-info">
                            <div class="inner">
                                <div class="icon-box">
                                    <span class="flaticon-maps-and-flags"></span>
                                </div>
                                <h3>Adres</h3>
                                <div class="text">33 Havemeyer St, Brooklyn, NY 11211 United States</div>
                            </div>
                        </div>

                        <!--Contact Info-->
                        <div class="contact-info">
                            <div class="inner">
                                <div class="icon-box">
                                    <span class="flaticon-technology"></span>
                                </div>
                                <h3>Telefon</h3>
                                <div class="text">(881)123456789 <br> (881)123456789</div>
                            </div>
                        </div>

                        <!--Contact Info-->
                        <div class="contact-info">
                            <div class="inner">
                                <div class="icon-box">
                                    <span class="flaticon-web"></span>
                                </div>
                                <h3>E-Posta</h3>
                                <div class="text">Info@rightscale.com <br> rightscale@construction.com</div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!--Map Section-->
<section class="map-section">
    <!--Map Outer-->
    <div class="map-outer">
        <!--Map Canvas-->
        <div class="map-canvas"
             data-zoom="12"
             data-lat="-37.817085"
             data-lng="144.955631"
             data-type="roadmap"
             data-hue="#ffc400"
             data-title="Envato"
             data-icon-path="~/images/icons/map-marker.png"
             data-content="Melbourne VIC 3000, Australia<br><a href='mailto:info@youremail.com'>info@youremail.com</a>">
        </div>
    </div>
</section>
<!--End Map Section-->


