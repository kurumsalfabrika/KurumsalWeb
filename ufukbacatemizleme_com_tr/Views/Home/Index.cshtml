@model GenelViewModel
@{
    ViewData["Title"] = "Ana Sayfa";
}
@section Styles{

    <!-- Stylesheets -->
    <link href="~/css/bootstrap.css" rel="stylesheet">
    <link href="~/plugins/revolution/css/settings.css" rel="stylesheet" type="text/css"><!-- REVOLUTION SETTINGS STYLES -->
    <link href="~/plugins/revolution/css/layers.css" rel="stylesheet" type="text/css"><!-- REVOLUTION LAYERS STYLES -->
    <link href="~/plugins/revolution/css/navigation.css" rel="stylesheet" type="text/css"><!-- REVOLUTION NAVIGATION STYLES -->
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/responsive.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <!-- Color Themes -->
    <link id="theme-color-file" href="~/css/color-themes/red-theme.css" rel="stylesheet">

    <!-- Favicon -->
    <link rel="shortcut icon" href="~/images/favicon.png" type="image/x-icon">
    <link rel="icon" href="~/images/favicon.png" type="image/x-icon">

    <!-- Responsive -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">

    <!-- Support for Older IE Browsers -->
    <!--[if lt IE 9]>
    <script src="js/html5shiv.js"></script>
    <script src="js/respond.js"></script>
    <![endif]-->

}

<section class="main-slider">
    <div class="rev_slider_wrapper fullwidthbanner-container" id="rev_slider_one_wrapper" data-source="gallery">
        <div class="rev_slider fullwidthabanner" id="rev_slider_one" data-version="5.4.1">
            <ul>@{
                    int sira = 1;
                }
                @foreach (var item in Model.Sliderlar)
                {
                    sira++;

                    <li data-description="@item.SliderBaslik" data-easein="default" data-easeout="default" data-fsmasterspeed="1500" data-fsslotamount="7" data-fstransition="fade" data-hideafterloop="0" data-hideslideonmobile="off" data-index="rs-168 @sira" data-masterspeed="default" data-param1="" data-param10="" data-param2="" data-param3="" data-param4="" data-param5="" data-param6="" data-param7="" data-param8="" data-param9="" data-rotate="0" data-saveperformance="off" data-slotamount="default" data-thumb="@Model.Ftp.DosyaAdresOnEki@item.OneCikanGorsel" data-title="@item.SliderBaslik" data-transition="parallaxvertical">
                        <img alt="" class="rev-slidebg" data-bgfit="cover" data-bgparallax="10" data-bgposition="center center" data-bgrepeat="no-repeat" data-no-retina="" src="@Model.Ftp.DosyaAdresOnEki@item.OneCikanGorsel">

                        <div class="tp-caption tp-resizeme"
                             data-paddingbottom="[0,0,0,0]"
                             data-paddingleft="[0,0,0,0]"
                             data-paddingright="[0,0,0,0]"
                             data-paddingtop="[0,0,0,0]"
                             data-responsive_offset="on"
                             data-type="text"
                             data-height="none"
                             data-whitespace="nowrap"
                             data-width="none"
                             data-hoffset="['15','15','15','15']"
                             data-voffset="['-10','25','10','10']"
                             data-x="['left','left','left','left']"
                             data-y="['middle','middle','middle','middle']"
                             data-textalign="['top','top','top','top']"
                             data-frames='[{"from":"x:[-100%];z:0;rX:0deg;rY:0;rZ:0;sX:1;sY:1;skX:0;skY:0;","mask":"x:0px;y:0px;s:inherit;e:inherit;","speed":1500,"to":"o:1;","delay":1000,"ease":"Power3.easeInOut"},{"delay":"wait","speed":1000,"to":"auto:auto;","mask":"x:0;y:0;s:inherit;e:inherit;","ease":"Power3.easeInOut"}]'>
                            <div class="text">@item.SliderBaslik</div>
                        </div>

                        <div class="tp-caption"
                             data-paddingbottom="[0,0,0,0]"
                             data-paddingleft="[0,0,0,0]"
                             data-paddingright="[0,0,0,0]"
                             data-paddingtop="[0,0,0,0]"
                             data-responsive_offset="on"
                             data-type="text"
                             data-height="none"
                             data-width="['600','600','600','360']"
                             data-whitespace="normal"
                             data-hoffset="['15','15','15','15']"
                             data-voffset="['90','-90','-80','-65']"
                             data-x="['left','left','left','left']"
                             data-y="['middle','middle','middle','middle']"
                             data-textalign="['top','top','top','top']"
                             data-frames='[{"from":"y:[100%];z:0;rX:0deg;rY:0;rZ:0;sX:1;sY:1;skX:0;skY:0;","mask":"x:0px;y:0px;s:inherit;e:inherit;","speed":1500,"to":"o:1;","delay":1000,"ease":"Power3.easeInOut"},{"delay":"wait","speed":1000,"to":"auto:auto;","mask":"x:0;y:0;s:inherit;e:inherit;","ease":"Power3.easeInOut"}]'>
                            <h2>@item.IkinciSatir <br> @item.UcuncuSatir</h2>
                        </div>

                        <div class="tp-caption tp-resizeme"
                             data-paddingbottom="[0,0,0,0]"
                             data-paddingleft="[0,0,0,0]"
                             data-paddingright="[0,0,0,0]"
                             data-paddingtop="[0,0,0,0]"
                             data-responsive_offset="on"
                             data-type="text"
                             data-height="none"
                             data-width="['600','600','400','360']"
                             data-whitespace="normal"
                             data-hoffset="['15','15','15','15']"
                             data-voffset="['210','105','90','85']"
                             data-x="['left','left','left','left']"
                             data-y="['middle','middle','middle','middle']"
                             data-textalign="['top','top','top','top']"
                             data-frames='[{"from":"y:[100%];z:0;rX:0deg;rY:0;rZ:0;sX:1;sY:1;skX:0;skY:0;","mask":"x:0px;y:0px;s:inherit;e:inherit;","speed":1500,"to":"o:1;","delay":1000,"ease":"Power3.easeInOut"},{"delay":"wait","speed":1000,"to":"auto:auto;","mask":"x:0;y:0;s:inherit;e:inherit;","ease":"Power3.easeInOut"}]'>
                            <a href="@item.SliderURL" class="theme-btn btn-style-one">@item.ButonYazisi</a>
                        </div>
                    </li>
                }

            </ul>
        </div>
    </div>
</section>

<section class="services-section">
    <div class="auto-container">
        <!--Sec Title Two-->
        <div class="sec-title-two">
            <div class="inner-title">
                <div class="title">Bizi Tanıyın</div>
                <h2>Profesyonel / Güvenilir</h2>
            </div>
        </div>
        <div class="row clearfix">
            <div class="column pull-left col-md-4 col-sm-6 col-xs-12">
                <!--Services Block-->
                <div class="services-block">
                    <div class="inner-box">
                        <div class="icon-box">
                            <i class="fas fa-wind"></i>
                        </div>
                        <h3><a href="services.html">KAYSERİ BACA TEMZİLEME</a></h3>
                        <div class="text">Baca temizliğinde sorumlu firma olmanın gururunu taşıyoruz. </div>
                    </div>
                </div>

                <!--Services Block-->
                <div class="services-block">
                    <div class="inner-box">
                        <div class="icon-box">
                            <i class="fas fa-fire-extinguisher"></i>
                        </div>
                        <h3><a href="services.html">İTFAİYE BŞK. DENETİMİNDEYİZ</a></h3>
                        <div class="text">Firmamız Kayseri Büyükşehir Belediyesi İtfaiye Başkanlığı denetimindedir. </div>
                    </div>
                </div>

            </div>
            <div class="column pull-right col-md-4 col-sm-6 col-xs-12">
                <!--Services Block Two-->
                <div class="services-block-two">
                    <div class="inner-box">
                        <div class="icon-box">
                            <i class="fas fa-file-alt"></i>
                        </div>
                        <h3><a href="services.html">BACA TEMZİLEME YÖNETMELİĞİ</a></h3>
                        <div class="text">Bilgi sahibi olmanız için baca temizleme ve denetim yönetmeliğini inceleyebilirsiniz. </div>
                    </div>
                </div>

                <!--Services Block Two-->
                <div class="services-block-two">
                    <div class="inner-box">
                        <div class="icon-box">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <h3><a href="services.html">ONAYLI BACA RAPORU</a></h3>
                        <div class="text">İtfaiye onaylı baca raporu firmamız tarafından verilmektedir. </div>
                    </div>
                </div>

            </div>
            <div class="image-column col-md-4 col-sm-12 col-xs-12">
                <div class="image">
                    <img src="~/images/resource/image-1.jpg" alt="" />
                </div>
            </div>
        </div>
    </div>
</section>

<!--Clients Section-->
<section class="client-section">
    <div class="auto-container">
        <div class="row clearfix">
            <!--Column-->
            <div class="title-column col-md-4 col-sm-12 col-xs-12">
                <!--Sec Title-->
                <div class="sec-title">
                    <div class="title">Bizi Tercih Edenler</div>
                    <h2>Referanslar</h2>
                </div>
                <div class="text">Profesyonel hizmetlerimizden yararlanan müşterilerimiz.</div>
            </div>
            <!--Column-->
            <div class="col-md-8 col-sm-12 col-xs-12">
                <div class="sponsors-outer">
                    <!--Sponsors Carousel-->
                    <ul class="sponsors-carousel owl-carousel owl-theme">
                        @foreach (var item in Model.Referanslar)
                        {
                            <li class="slide-item"><figure class="image-box"><a href="#"><img src="@Model.Ftp.DosyaAdresOnEki@item.OneCikanGorsel" alt=""></a></figure></li>
                        }
                   </ul>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts{
    <script src="~/js/jquery.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <!--Revolution Slider-->
    <script src="~/plugins/revolution/js/jquery.themepunch.revolution.min.js"></script>
    <script src="~/plugins/revolution/js/jquery.themepunch.tools.min.js"></script>
    <script src="~/plugins/revolution/js/extensions/revolution.extension.actions.min.js"></script>
    <script src="~/plugins/revolution/js/extensions/revolution.extension.carousel.min.js"></script>
    <script src="~/plugins/revolution/js/extensions/revolution.extension.kenburn.min.js"></script>
    <script src="~/plugins/revolution/js/extensions/revolution.extension.layeranimation.min.js"></script>
    <script src="~/plugins/revolution/js/extensions/revolution.extension.migration.min.js"></script>
    <script src="~/plugins/revolution/js/extensions/revolution.extension.navigation.min.js"></script>
    <script src="~/plugins/revolution/js/extensions/revolution.extension.parallax.min.js"></script>
    <script src="~/plugins/revolution/js/extensions/revolution.extension.slideanims.min.js"></script>
    <script src="~/plugins/revolution/js/extensions/revolution.extension.video.min.js"></script>
    <script src="~/js/main-slider-script.js"></script>
    <!--End Revolution Slider-->
    <script src="~/js/jquery.fancybox.pack.js"></script>
    <script src="~/js/jquery.fancybox-media.js"></script>
    <script src="~/js/owl.js"></script>
    <script src="~/js/appear.js"></script>
    <script src="~/js/wow.js"></script>
    <script src="~/js/jquery-ui.js"></script>
    <script src="~/js/main-slider-script.js"></script>
    <script src="~/js/mixitup.js"></script>
    <script src="~/js/script.js"></script>
}